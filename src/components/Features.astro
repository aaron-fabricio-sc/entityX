---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import DigitalCredential from './DigitalCredential.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const problemSolutionItems = Array.from({ length: 10 }, (_, index) => index + 6);
const moduleCards = [
    { icon: 'bi-card-checklist', title: 'feat.membership.list1.title', desc: 'feat.membership.list1.desc' },
    { icon: 'bi-person-lines-fill', title: 'feat.membership.list4.title', desc: 'feat.membership.list4.desc' },
    { icon: 'bi-calendar3', title: 'feat.membership.list5.title', desc: 'feat.membership.list5.desc' },
    { icon: 'bi-cart-check', title: 'feat.membership.list2.title', desc: 'feat.membership.list2.desc' },
    { icon: 'bi-people', title: 'feat.membership.list3.title', desc: 'feat.membership.list3.desc' },
    { icon: 'bi-phone', title: 'feat.access.title', desc: 'feat.access.card_desc' },
    { icon: 'bi-graph-up-arrow', title: 'feat.membership.list6.title', desc: 'feat.membership.list6.desc' },
    { icon: 'bi-person-check', title: 'feat.membership.list7.title', desc: 'feat.membership.list7.desc' },
    { icon: 'bi-cash-coin', title: 'feat.membership.list8.title', desc: 'feat.membership.list8.desc' },
    { icon: 'bi-cloud-check', title: 'feat.membership.list9.title', desc: 'feat.membership.list9.desc' },
];
---

<!-- Section 1: Problem vs Solution -->
<section id="features" class="py-5 bg-dark-teal pt-5"> 
    <div class="container py-5 mt-4">
        <div class="row align-items-center mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold text-neon mb-4">{t('feat.whatis.title')}</h2>
                <p class="lead text-light">{t('feat.whatis.desc')}</p>
                <p class="mb-5 text-light">{t('feat.whatis.p1')}</p>
            </div>
        </div>
        
        <div class="row justify-content-center">
            <div class="col-xl-11">
                <div class="card card-neon-animated border-0 rounded-4">
                    <div class="card-body p-3 p-md-4">
                        <div class="problem-grid">
                            {problemSolutionItems.map((item) => (
                                <div class="problem-solution-card card-neon-animated">
                                    <div class="problem-line">
                                        <div class="compact-heading">
                                            <i class="bi bi-x-circle text-danger"></i>
                                            <h5 class="text-white">{t(`feat.prob.${item}.title`)}</h5>
                                        </div>
                                    </div>

                                    <div class="solution-line">
                                        <div class="compact-heading">
                                            <i class="bi bi-check-circle text-neon"></i>
                                            <h5 class="text-neon">{t(`feat.sol.${item}.title`)}</h5>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 2: Core Modules -->
<section class="py-5 bg-sidebar">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('feat.membership.subtitle')}</span>
            <h2 class="display-5 fw-bold text-white mb-3">{t('feat.membership.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 700px;">{t('feat.membership.desc')}</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            {moduleCards.map((card) => (
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                        <i class={`bi ${card.icon} fs-1 text-neon mb-3`}></i>
                        <h5 class="text-white fw-bold">{t(card.title)}</h5>
                        <p class="text-light small mb-0">{t(card.desc)}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<DigitalCredential />

<!-- Section 3: Target Niches (For Who) -->
<section class="py-5 bg-dark-teal">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-neon mb-3">{t('feat.agnostic.title')}</h2>
            <p class="lead text-light mx-auto mb-4" style="max-width: 800px;">{t('feat.agnostic.desc')}</p>
        </div>
        
        <!-- Niches Grid -->
        <div class="row g-4 justify-content-center">
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/gyms.jpeg'} class="w-100 h-100 object-fit-cover" alt="Software de gestión para gimnasios, crossfit y centros deportivos" loading="lazy" decoding="async" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-bicycle me-2 text-neon"></i>{t('biz.gym')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Yoga_Pilates_color_scheme_202607060947.jpeg'} class="w-100 h-100 object-fit-cover" alt="Aplicación para gestionar centros de yoga y pilates" loading="lazy" decoding="async" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-flower1 me-2 text-neon"></i>{t('biz.yoga')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Imagen_quita_fondo_pone_deporte_202607061122.jpeg'} class="w-100 h-100 object-fit-cover" alt="Sistema administrativo para escuelas deportivas y clases por membresía" loading="lazy" decoding="async" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-trophy me-2 text-neon"></i>{t('biz.deportes')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Mejora_imagen_quita_lineas_negras_202607061114.jpeg'} class="w-100 h-100 object-fit-cover" alt="ERP ligero para academias de artes marciales y control de alumnos" loading="lazy" decoding="async" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-yin-yang me-2 text-neon"></i>{t('biz.martial')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Colores_neon_y_EntityX_fondo_202607061004.jpeg'} class="w-100 h-100 object-fit-cover" alt="Software para academias de danza, música y gestión de horarios de clases" loading="lazy" decoding="async" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-music-note-beamed me-2 text-neon"></i>{t('biz.danza')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/mejora_la_calida_esa_imagen_202607061126.jpeg'} class="w-100 h-100 object-fit-cover" alt="Sistema de gestión para institutos educativos, academias y cursos" loading="lazy" decoding="async" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-book me-2 text-neon"></i>{t('biz.education')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Mejora_calidad_de_imagen_202607061128.jpeg'} class="w-100 h-100 object-fit-cover" alt="Aplicación en la nube para spas, estética y negocios por reservas" loading="lazy" decoding="async" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-heart me-2 text-neon"></i>{t('biz.spa')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Generate_other_images_neon_202607061007.jpeg'} class="w-100 h-100 object-fit-cover" alt="Sistema para coworking, clubes y espacios compartidos con membresías" loading="lazy" decoding="async" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-laptop me-2 text-neon"></i>{t('biz.coworking')}</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



<style>
    .bg-dark-teal {
        background-color: var(--nav-color);
    }
    .hover-scale {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    }
    .hover-scale:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 243, 255, 0.15) !important;
        border-color: var(--neon-cyan) !important;
    }
    .feature-card:hover {
        background-color: rgba(5, 25, 33, 0.8) !important;
    }
    #features h2,
    section.bg-sidebar h2,
    section.bg-dark-teal h2 {
        font-size: 2.35rem !important;
        line-height: 1.18;
    }
    #features .lead,
    section.bg-sidebar .lead,
    section.bg-dark-teal .lead {
        font-size: 1.08rem;
        line-height: 1.5;
    }
    #features p,
    section.bg-sidebar p,
    section.bg-dark-teal p {
        font-size: 1rem;
        line-height: 1.5;
    }
    section.bg-sidebar .card h5 {
        font-size: 1.05rem;
        line-height: 1.3;
    }
    section.bg-sidebar .card p.small {
        font-size: 0.95rem;
        line-height: 1.45;
    }
    .biz-card h5 {
        font-size: 1.05rem !important;
        line-height: 1.25;
    }
    .problem-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
    }
    .problem-solution-card {
        display: grid;
        gap: 0.65rem;
        padding: 0.95rem;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 12px;
        background: rgba(2, 16, 20, 0.72);
    }
    .problem-line,
    .solution-line {
        display: grid;
        gap: 0.25rem;
    }
    .solution-line {
        padding-top: 0.55rem;
        border-top: 1px solid rgba(148, 163, 184, 0.12);
    }
    .compact-heading {
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }
    .compact-heading i {
        font-size: 0.95rem;
        line-height: 1;
        flex: 0 0 auto;
    }
    .compact-heading h5 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.2;
    }
    .problem-solution-card p {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.45;
    }
    @media (max-width: 1199.98px) {
        #features h2,
        section.bg-sidebar h2,
        section.bg-dark-teal h2 {
            font-size: 2rem !important;
        }
        #features .lead,
        section.bg-sidebar .lead,
        section.bg-dark-teal .lead {
            font-size: 1rem;
        }
        #features p,
        section.bg-sidebar p,
        section.bg-dark-teal p {
            font-size: 0.94rem;
        }
        section.bg-sidebar .card h5,
        .compact-heading h5,
        .biz-card h5 {
            font-size: 0.98rem !important;
        }
        section.bg-sidebar .card p.small,
        .problem-solution-card p {
            font-size: 0.88rem;
        }
    }
    @media (max-width: 767.98px) {
        #features h2,
        section.bg-sidebar h2,
        section.bg-dark-teal h2 {
            font-size: 1.55rem !important;
            line-height: 1.2;
        }
        #features .lead,
        section.bg-sidebar .lead,
        section.bg-dark-teal .lead {
            font-size: 0.92rem !important;
            line-height: 1.45;
        }
        #features p,
        section.bg-sidebar p,
        section.bg-dark-teal p {
            font-size: 0.88rem;
            line-height: 1.45;
        }
        section.bg-sidebar .card h5,
        .compact-heading h5,
        .biz-card h5 {
            font-size: 0.9rem !important;
            line-height: 1.25;
        }
        section.bg-sidebar .card p.small,
        .problem-solution-card p {
            font-size: 0.82rem;
            line-height: 1.35;
        }
        .problem-grid {
            grid-template-columns: 1fr;
            gap: 0.7rem;
        }
        .problem-solution-card {
            padding: 0.85rem;
            gap: 0.5rem;
        }
    }
    .bg-gradient-dark {
        background: linear-gradient(to top, rgba(2, 16, 20, 0.95) 0%, rgba(2, 16, 20, 0) 100%);
    }
    .biz-card {
        transition: transform 0.3s;
    }
    .biz-card:hover {
        transform: scale(1.03);
    }
</style>
