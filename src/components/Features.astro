---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Section 1: Problem vs Solution -->
<section id="features" class="py-5 bg-dark-teal pt-5"> 
    <div class="container py-5 mt-4">
        <div class="row align-items-center mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold text-neon mb-4">{t('feat.whatis.title')}</h2>
                <p class="lead text-light">{t('feat.whatis.desc')}</p>
                <p class="mb-5 text-light">{t('feat.whatis.p1')}</p>
            </div>
        </div>
        
        <div class="row g-4 justify-content-center">
            <!-- Problem -->
            <div class="col-md-6 col-lg-5">
                <div class="card card-neon-animated border-0 h-100 rounded-4">
                    <div class="card-body p-5">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-x-circle fs-3 text-danger me-3"></i>
                            <h4 class="card-title text-white fw-bold mb-0">{t('feat.prob.1.title')}</h4>
                        </div>
                        <p class="card-text text-light small mb-4">{t('feat.prob.1.desc')}</p>
                        
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-x-circle fs-5 text-danger me-3"></i>
                            <h5 class="text-white fw-bold mb-0">{t('feat.prob.2.title')}</h5>
                        </div>
                        <p class="small text-light mb-4">{t('feat.prob.2.desc')}</p>

                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-x-circle fs-5 text-danger me-3"></i>
                            <h5 class="text-white fw-bold mb-0">{t('feat.prob.3.title')}</h5>
                        </div>
                        <p class="small text-light mb-4">{t('feat.prob.3.desc')}</p>

                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-x-circle fs-5 text-danger me-3"></i>
                            <h5 class="text-white fw-bold mb-0">{t('feat.prob.4.title')}</h5>
                        </div>
                        <p class="small text-light mb-4">{t('feat.prob.4.desc')}</p>

                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-x-circle fs-5 text-danger me-3"></i>
                            <h5 class="text-white fw-bold mb-0">{t('feat.prob.5.title')}</h5>
                        </div>
                        <p class="small text-light m-0">{t('feat.prob.5.desc')}</p>
                    </div>
                </div>
            </div>
            
            <!-- Solution -->
            <div class="col-md-6 col-lg-5">
                <div class="card card-neon-animated h-100 rounded-4">
                    <div class="card-body p-5">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-check-circle fs-3 text-neon me-3"></i>
                            <h4 class="card-title text-neon fw-bold mb-0">{t('feat.sol.1.title')}</h4>
                        </div>
                        <p class="card-text text-light small mb-4">{t('feat.sol.1.desc')}</p>
                        
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-check-circle fs-5 text-neon me-3"></i>
                            <h5 class="text-white fw-bold mb-0">{t('feat.sol.2.title')}</h5>
                        </div>
                        <p class="small text-light mb-4">{t('feat.sol.2.desc')}</p>
                        
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-check-circle fs-5 text-neon me-3"></i>
                            <h5 class="text-white fw-bold mb-0">{t('feat.sol.3.title')}</h5>
                        </div>
                        <p class="small text-light mb-4">{t('feat.sol.3.desc')}</p>

                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-check-circle fs-5 text-neon me-3"></i>
                            <h5 class="text-white fw-bold mb-0">{t('feat.sol.4.title')}</h5>
                        </div>
                        <p class="small text-light mb-4">{t('feat.sol.4.desc')}</p>

                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-check-circle fs-5 text-neon me-3"></i>
                            <h5 class="text-white fw-bold mb-0">{t('feat.sol.5.title')}</h5>
                        </div>
                        <p class="small text-light m-0">{t('feat.sol.5.desc')}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 2: Core Modules -->
<section class="py-5 bg-sidebar">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('feat.membership.subtitle')}</span>
            <h2 class="display-5 fw-bold text-white mb-3">{t('feat.membership.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 700px;">{t('feat.membership.desc')}</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-card-checklist fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.membership.list1.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.membership.list1.desc')}</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-cart-check fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.membership.list2.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.membership.list2.desc')}</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-people fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.membership.list3.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.membership.list3.desc')}</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-phone fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.access.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.access.desc')} {t('feat.access.list1')} {t('feat.access.list2')}</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Target Niches (For Who) -->
<section class="py-5 bg-dark-teal">
    <div class="container py-5">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h2 class="display-5 fw-bold text-neon mb-4">{t('feat.agnostic.title')}</h2>
                <p class="lead text-light mb-4">{t('feat.agnostic.desc')}</p>
            </div>
            <div class="col-lg-6">
                <!-- Niches Grid -->
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card">
                            <img src={import.meta.env.BASE_URL + 'imagenes/image.png'} class="w-100 h-100 object-fit-cover" alt="Gym" style="min-height: 200px;">
                            <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                                <h5 class="text-white mb-0 fs-5"><i class="bi bi-bicycle me-2"></i>{t('biz.gym')}</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card">
                            <img src={import.meta.env.BASE_URL + 'imagenes/image(3).png'} class="w-100 h-100 object-fit-cover" alt="Academy" style="min-height: 200px;">
                            <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                                <h5 class="text-white mb-0 fs-5"><i class="bi bi-music-note-beamed me-2"></i>{t('biz.school')}</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card">
                            <img src={import.meta.env.BASE_URL + 'imagenes/image(4).png'} class="w-100 h-100 object-fit-cover" alt="Sports" style="min-height: 200px;">
                            <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                                <h5 class="text-white mb-0 fs-5"><i class="bi bi-trophy me-2"></i>{t('biz.deportes')}</h5>
                            </div>
                        </div>
                    </div>
                   <div class="col-sm-6">
                        <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card">
                            <img src={import.meta.env.BASE_URL + 'imagenes/image(2).png'} class="w-100 h-100 object-fit-cover" alt="Coworking" style="min-height: 200px;">
                            <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                                <h5 class="text-white mb-0 fs-5"><i class="bi bi-building me-2"></i>{t('biz.spa')}</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



<style>
    .bg-dark-teal {
        background-color: var(--nav-color);
    }
    .hover-scale {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    }
    .hover-scale:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 243, 255, 0.15) !important;
        border-color: var(--neon-cyan) !important;
    }
    .feature-card:hover {
        background-color: rgba(5, 25, 33, 0.8) !important;
    }
    .bg-gradient-dark {
        background: linear-gradient(to top, rgba(2, 16, 20, 0.95) 0%, rgba(2, 16, 20, 0) 100%);
    }
    .biz-card {
        transition: transform 0.3s;
    }
    .biz-card:hover {
        transform: scale(1.03);
    }
</style>
