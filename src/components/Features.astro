---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import DigitalCredential from './DigitalCredential.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const moduleCards = [
    { icon: 'bi-patch-check', title: 'feat.membership.list1.title', desc: 'feat.membership.list1.desc' },
    { icon: 'bi-person-vcard', title: 'feat.membership.list4.title', desc: 'feat.membership.list4.desc' },
    { icon: 'bi-calendar2-week', title: 'feat.membership.list5.title', desc: 'feat.membership.list5.desc' },
    { icon: 'bi-receipt-cutoff', title: 'feat.membership.list2.title', desc: 'feat.membership.list2.desc' },
    { icon: 'bi-shield-lock', title: 'feat.membership.list3.title', desc: 'feat.membership.list3.desc' },
    { icon: 'bi-qr-code-scan', title: 'feat.access.title', desc: 'feat.access.card_desc' },
    { icon: 'bi-bar-chart-line', title: 'feat.membership.list6.title', desc: 'feat.membership.list6.desc' },
    { icon: 'bi-clock-history', title: 'feat.membership.list7.title', desc: 'feat.membership.list7.desc' },
    { icon: 'bi-wallet2', title: 'feat.membership.list8.title', desc: 'feat.membership.list8.desc' },
    { icon: 'bi-cloud-check', title: 'feat.membership.list9.title', desc: 'feat.membership.list9.desc' },
];
const nicheCards = [
    { image: 'gyms.jpeg', alt: 'Software de gestión para gimnasios y centros deportivos', icon: 'bi-bicycle', title: 'biz.gym', flow: 'biz.gym.flow' },
    { image: 'Yoga_Pilates_color_scheme_202607060947.jpeg', alt: 'Sistema de gestión para estudios de yoga y pilates', icon: 'bi-flower1', title: 'biz.yoga', flow: 'biz.yoga.flow' },
    { image: 'Imagen_quita_fondo_pone_deporte_202607061122.jpeg', alt: 'Sistema administrativo para escuelas deportivas', icon: 'bi-trophy', title: 'biz.deportes', flow: 'biz.deportes.flow' },
    { image: 'Mejora_imagen_quita_lineas_negras_202607061114.jpeg', alt: 'Sistema de gestión para artes marciales', icon: 'bi-yin-yang', title: 'biz.martial', flow: 'biz.martial.flow' },
    { image: 'Colores_neon_y_EntityX_fondo_202607061004.jpeg', alt: 'Sistema de gestión para danza y música', icon: 'bi-music-note-beamed', title: 'biz.danza', flow: 'biz.danza.flow' },
    { image: 'mejora_la_calida_esa_imagen_202607061126.jpeg', alt: 'Sistema de gestión para institutos educativos', icon: 'bi-book', title: 'biz.education', flow: 'biz.education.flow' },
    { image: 'Mejora_calidad_de_imagen_202607061128.jpeg', alt: 'Sistema de gestión para spas y estética', icon: 'bi-heart', title: 'biz.spa', flow: 'biz.spa.flow' },
    { image: 'Generate_other_images_neon_202607061007.jpeg', alt: 'Sistema de gestión para coworking y clubes', icon: 'bi-laptop', title: 'biz.coworking', flow: 'biz.coworking.flow' },
];
const workflowSteps = [
    { icon: 'bi-sliders', number: '01', title: 'workflow.step1.title', desc: 'workflow.step1.desc' },
    { icon: 'bi-clipboard-data', number: '02', title: 'workflow.step2.title', desc: 'workflow.step2.desc' },
    { icon: 'bi-graph-up-arrow', number: '03', title: 'workflow.step3.title', desc: 'workflow.step3.desc' },
];
const faqItems = Array.from({ length: 5 }, (_, index) => index + 1);
---

<!-- Core solutions -->
<section id="features" class="py-5 bg-dark-teal">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('feat.membership.subtitle')}</span>
            <h2 class="display-5 fw-bold text-neon mb-3">{t('feat.whatis.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 760px;">{t('feat.whatis.desc')}</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            {moduleCards.map((card) => (
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                        <i class={`bi ${card.icon} fs-1 text-neon mb-3`}></i>
                        <h5 class="text-white fw-bold">{t(card.title)}</h5>
                        <p class="text-light small mb-0">{t(card.desc)}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- How it works -->
<section class="workflow-section py-5 bg-sidebar">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('workflow.badge')}</span>
            <h2 class="display-5 fw-bold text-white mb-3">{t('workflow.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 760px;">{t('workflow.desc')}</p>
        </div>
        <div class="row g-4 justify-content-center">
            {workflowSteps.map((step) => (
                <div class="col-md-4">
                    <article class="workflow-card h-100 rounded-4 p-4">
                        <span class="workflow-card__number">{step.number}</span>
                        <i class={`bi ${step.icon} workflow-card__icon`}></i>
                        <h3 class="h5 text-white fw-bold mt-4 mb-2">{t(step.title)}</h3>
                        <p class="text-light mb-0">{t(step.desc)}</p>
                    </article>
                </div>
            ))}
        </div>
    </div>
</section>

<DigitalCredential />

<!-- Compatible sectors -->
<section class="py-5 bg-dark-teal">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-neon mb-3">{t('feat.agnostic.title')}</h2>
            <p class="lead text-light mx-auto mb-4" style="max-width: 800px;">{t('feat.agnostic.desc')}</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            {nicheCards.map((card) => (
                <div class="col-md-6 col-lg-4">
                    <article class="niche-card d-flex flex-row h-100 rounded-4 overflow-hidden border border-secondary border-opacity-10">
                        <img src={import.meta.env.BASE_URL + `imagenes/${card.image}`} class="niche-card__image" alt={card.alt} loading="lazy" decoding="async" />
                        <div class="niche-card__body">
                            <h3 class="text-white h5 fw-bold mb-2"><i class={`bi ${card.icon} me-2 text-neon`}></i>{t(card.title)}</h3>
                            <p class="text-light mb-0">{t(card.flow)}</p>
                        </div>
                    </article>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Frequently asked questions -->
<section class="faq-section py-5 bg-sidebar">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-white mb-3">{t('faq.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 720px;">{t('faq.desc')}</p>
        </div>
        <div class="faq-list mx-auto">
            {faqItems.map((item) => (
                <details class="faq-item">
                    <summary>{t(`faq.${item}.question`)}<i class="bi bi-plus-lg"></i></summary>
                    <p>{t(`faq.${item}.answer`)}</p>
                </details>
            ))}
        </div>
    </div>
</section>

<!-- Final call to action -->
<section class="final-cta py-5 bg-dark-teal">
    <div class="container py-5 text-center">
        <h2 class="display-5 fw-bold text-neon mb-3">{t('cta.final.title')}</h2>
        <p class="lead text-light mx-auto mb-4" style="max-width: 700px;">{t('cta.final.desc')}</p>
        <a
            href={`https://wa.me/59170668135?text=${encodeURIComponent(t('hero.whatsapp_message'))}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg px-4 py-3 rounded-pill shadow-lg"
        >{t('cta.final.button')} <i class="bi bi-arrow-right ms-2"></i></a>
    </div>
</section>



<style>
    .bg-dark-teal {
        background-color: var(--nav-color);
    }
    .hover-scale {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    }
    .hover-scale:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 243, 255, 0.15) !important;
        border-color: var(--neon-cyan) !important;
    }
    .feature-card:hover {
        background-color: rgba(5, 25, 33, 0.8) !important;
    }
    #features h2,
    #features h2,
    section.bg-dark-teal h2 {
        font-size: 2.35rem !important;
        line-height: 1.18;
    }
    #features .lead,
    #features .lead,
    section.bg-dark-teal .lead {
        font-size: 1.08rem;
        line-height: 1.5;
    }
    #features p,
    #features p,
    section.bg-dark-teal p {
        font-size: 1rem;
        line-height: 1.5;
    }
    #features .card h5 {
        font-size: 1.05rem;
        line-height: 1.3;
    }
    #features .card p.small {
        font-size: 0.95rem;
        line-height: 1.45;
    }
    .niche-card {
        display: flex !important;
        flex-direction: row !important;
        align-items: center;
        background: rgba(5, 25, 33, 0.82);
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .niche-card__image {
        flex: 0 0 172px !important;
        width: 172px !important;
        height: 172px !important;
        aspect-ratio: 1;
        object-fit: contain;
        object-position: center;
        background: #021014;
        border-right: 1px solid rgba(148, 163, 184, 0.16);
    }
    .niche-card__body {
        flex: 1 1 auto;
        min-width: 0;
        padding: 1rem;
    }
    .niche-card h3 {
        font-size: 1.1rem;
        line-height: 1.3;
    }
    .niche-card p {
        color: #b7ced1 !important;
        font-size: 0.94rem;
        line-height: 1.5;
    }
    .niche-card:hover {
        transform: translateY(-5px);
        border-color: rgba(0, 255, 200, 0.6) !important;
        box-shadow: 0 12px 28px rgba(0, 243, 255, 0.12);
    }
    .workflow-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(0, 243, 255, 0.16);
        background: rgba(2, 16, 20, 0.58);
    }
    .workflow-card__number {
        color: rgba(0, 255, 200, 0.42);
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1;
    }
    .workflow-card__icon {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        color: var(--active-color);
        font-size: 2rem;
    }
    .workflow-card p {
        color: #b7ced1 !important;
        line-height: 1.55;
    }
    .faq-list {
        max-width: 860px;
    }
    .faq-item {
        margin-bottom: 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 0.8rem;
        background: rgba(2, 16, 20, 0.48);
    }
    .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.25rem;
        color: #fff;
        cursor: pointer;
        font-weight: 700;
        list-style: none;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary i { color: var(--active-color); transition: transform 0.2s ease; }
    .faq-item[open] summary i { transform: rotate(45deg); }
    .faq-item p {
        margin: 0;
        padding: 0 1.25rem 1.1rem;
        color: #b7ced1 !important;
        line-height: 1.6;
    }
    @media (max-width: 1199.98px) {
        #features h2,
        #features h2,
        section.bg-dark-teal h2 {
            font-size: 2rem !important;
        }
        #features .lead,
        #features .lead,
        section.bg-dark-teal .lead {
            font-size: 1rem;
        }
        #features p,
        #features p,
        section.bg-dark-teal p {
            font-size: 0.94rem;
        }
        #features .card h5,
        .niche-card h3 {
            font-size: 0.98rem !important;
        }
        #features .card p.small {
            font-size: 0.88rem;
        }
    }
    @media (max-width: 767.98px) {
        #features h2,
        #features h2,
        section.bg-dark-teal h2 {
            font-size: 1.55rem !important;
            line-height: 1.2;
        }
        #features .lead,
        #features .lead,
        section.bg-dark-teal .lead {
            font-size: 0.92rem !important;
            line-height: 1.45;
        }
        #features p,
        #features p,
        section.bg-dark-teal p {
            font-size: 0.88rem;
            line-height: 1.45;
        }
        #features .card h5,
        .niche-card h3 {
            font-size: 0.9rem !important;
            line-height: 1.25;
        }
        #features .card p.small {
            font-size: 0.82rem;
            line-height: 1.35;
        }
        .niche-card__image {
            flex-basis: 138px !important;
            width: 138px !important;
            height: 138px !important;
        }
        .niche-card p {
            font-size: 0.88rem;
        }
    }
</style>
