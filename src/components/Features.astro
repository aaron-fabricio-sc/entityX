                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 2: Core Modules -->
<section class="py-5 bg-sidebar">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('feat.membership.subtitle')}</span>
            <h2 class="display-5 fw-bold text-white mb-3">{t('feat.membership.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 700px;">{t('feat.membership.desc')}</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            <!-- 1. Membresias -->
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-card-checklist fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.membership.list1.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.membership.list1.desc')}</p>
                </div>
            </div>
            <!-- 2. Base de Datos / CRM -->
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-person-lines-fill fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.membership.list4.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.membership.list4.desc')}</p>
                </div>
            </div>
            <!-- 3. Cronograma -->
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-calendar3 fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.membership.list5.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.membership.list5.desc')}</p>
                </div>
            </div>
            <!-- 4. Ventas -->
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-cart-check fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.membership.list2.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.membership.list2.desc')}</p>
                </div>
            </div>
            <!-- 5. RRHH -->
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-people fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.membership.list3.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.membership.list3.desc')}</p>
                </div>
            </div>
            <!-- 6. Portal -->
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                    <i class="bi bi-phone fs-1 text-neon mb-3"></i>
                    <h5 class="text-white fw-bold">{t('feat.access.title')}</h5>
                    <p class="text-light small mb-0">{t('feat.access.desc')} {t('feat.access.list1')} {t('feat.access.list2')}</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Target Niches (For Who) -->
<section class="py-5 bg-dark-teal">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-neon mb-3">{t('feat.agnostic.title')}</h2>
            <p class="lead text-light mx-auto mb-4" style="max-width: 800px;">{t('feat.agnostic.desc')}</p>
        </div>
        
        <!-- Niches Grid -->
        <div class="row g-4 justify-content-center">
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/gyms.jpeg'} class="w-100 h-100 object-fit-cover" alt="Gym" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-bicycle me-2 text-neon"></i>{t('biz.gym')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Yoga_Pilates_color_scheme_202607060947.jpeg'} class="w-100 h-100 object-fit-cover" alt="Yoga" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-flower1 me-2 text-neon"></i>{t('biz.yoga')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Imagen_quita_fondo_pone_deporte_202607061122.jpeg'} class="w-100 h-100 object-fit-cover" alt="Sports" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-trophy me-2 text-neon"></i>{t('biz.deportes')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Mejora_imagen_quita_lineas_negras_202607061114.jpeg'} class="w-100 h-100 object-fit-cover" alt="Martial Arts" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-yin-yang me-2 text-neon"></i>{t('biz.martial')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Colores_neon_y_EntityX_fondo_202607061004.jpeg'} class="w-100 h-100 object-fit-cover" alt="Dance" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-music-note-beamed me-2 text-neon"></i>{t('biz.danza')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/mejora_la_calida_esa_imagen_202607061126.jpeg'} class="w-100 h-100 object-fit-cover" alt="Education" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-book me-2 text-neon"></i>{t('biz.education')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Mejora_calidad_de_imagen_202607061128.jpeg'} class="w-100 h-100 object-fit-cover" alt="Spa" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-heart me-2 text-neon"></i>{t('biz.spa')}</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm h-100 biz-card border border-secondary border-opacity-10">
                    <img src={import.meta.env.BASE_URL + 'imagenes/Generate_other_images_neon_202607061007.jpeg'} class="w-100 h-100 object-fit-cover" alt="Coworking" style="min-height: 200px; background-color: rgba(2, 16, 20, 0.5);">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                        <h5 class="text-white mb-0 fs-5"><i class="bi bi-laptop me-2 text-neon"></i>{t('biz.coworking')}</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



<style>
    .bg-dark-teal {
        background-color: var(--nav-color);
    }
    .hover-scale {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    }
    .hover-scale:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 243, 255, 0.15) !important;
        border-color: var(--neon-cyan) !important;
    }
    .feature-card:hover {
        background-color: rgba(5, 25, 33, 0.8) !important;
    }
    .bg-gradient-dark {
        background: linear-gradient(to top, rgba(2, 16, 20, 0.95) 0%, rgba(2, 16, 20, 0) 100%);
    }
    .biz-card {
        transition: transform 0.3s;
    }
    .biz-card:hover {
        transform: scale(1.03);
    }
</style>
