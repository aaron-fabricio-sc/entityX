---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import DigitalCredential from './DigitalCredential.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const moduleCards = [
    { icon: 'bi-people', title: 'erp.clients.title', desc: 'erp.clients.desc' },
    { icon: 'bi-shop', title: 'erp.sales.title', desc: 'erp.sales.desc' },
    { icon: 'bi-box-seam', title: 'erp.inventory.title', desc: 'erp.inventory.desc' },
    { icon: 'bi-truck', title: 'erp.suppliers.title', desc: 'erp.suppliers.desc' },
    { icon: 'bi-kanban', title: 'erp.tasks.title', desc: 'erp.tasks.desc' },
    { icon: 'bi-cash-stack', title: 'erp.cash.title', desc: 'erp.cash.desc' },
    { icon: 'bi-buildings', title: 'erp.branches.title', desc: 'erp.branches.desc' },
    { icon: 'bi-person-lock', title: 'erp.team.title', desc: 'erp.team.desc' },
    { icon: 'bi-calendar2-check', title: 'erp.memberships.title', desc: 'erp.memberships.desc' },
    { icon: 'bi-graph-up-arrow', title: 'erp.reports.title', desc: 'erp.reports.desc' },
];
const nicheCards = [
    { icon: 'bi-bicycle', title: 'biz.gym', flow: 'biz.gym.flow' },
    { icon: 'bi-flower1', title: 'biz.yoga', flow: 'biz.yoga.flow' },
    { icon: 'bi-trophy', title: 'biz.deportes', flow: 'biz.deportes.flow' },
    { icon: 'bi-yin-yang', title: 'biz.martial', flow: 'biz.martial.flow' },
    { icon: 'bi-music-note-beamed', title: 'biz.danza', flow: 'biz.danza.flow' },
    { icon: 'bi-book', title: 'biz.education', flow: 'biz.education.flow' },
    { icon: 'bi-heart-pulse', title: 'biz.health', flow: 'biz.health.flow' },
    { icon: 'bi-capsule', title: 'biz.pharmacy', flow: 'biz.pharmacy.flow' },
    { icon: 'bi-bag-check', title: 'biz.retail', flow: 'biz.retail.flow' },
    { icon: 'bi-printer', title: 'biz.printing', flow: 'biz.printing.flow' },
    { icon: 'bi-tools', title: 'biz.workshops', flow: 'biz.workshops.flow' },
    { icon: 'bi-truck', title: 'biz.distribution', flow: 'biz.distribution.flow' },
    { icon: 'bi-box2-heart', title: 'biz.parcels', flow: 'biz.parcels.flow' },
    { icon: 'bi-stars', title: 'biz.spa', flow: 'biz.spa.flow' },
    { icon: 'bi-laptop', title: 'biz.coworking', flow: 'biz.coworking.flow' },
    { icon: 'bi-briefcase', title: 'biz.services', flow: 'biz.services.flow' },
];
const workflowSteps = [
    { icon: 'bi-sliders', number: '01', title: 'workflow.step1.title', desc: 'workflow.step1.desc' },
    { icon: 'bi-shop', number: '02', title: 'workflow.step2.title', desc: 'workflow.step2.desc' },
    { icon: 'bi-clipboard-data', number: '03', title: 'workflow.step3.title', desc: 'workflow.step3.desc' },
    { icon: 'bi-graph-up-arrow', number: '04', title: 'workflow.step4.title', desc: 'workflow.step4.desc' },
];
const inventoryBenefits = [
    { icon: 'bi-box-seam', title: 'inventory.benefit1.title', desc: 'inventory.benefit1.desc' },
    { icon: 'bi-shop-window', title: 'inventory.benefit2.title', desc: 'inventory.benefit2.desc' },
    { icon: 'bi-arrow-left-right', title: 'inventory.benefit3.title', desc: 'inventory.benefit3.desc' },
    { icon: 'bi-receipt', title: 'inventory.benefit4.title', desc: 'inventory.benefit4.desc' },
];
const teamBenefits = [
    { icon: 'bi-person-vcard', title: 'team.benefit1.title', desc: 'team.benefit1.desc' },
    { icon: 'bi-calendar2-check', title: 'team.benefit2.title', desc: 'team.benefit2.desc' },
    { icon: 'bi-cash-coin', title: 'team.benefit3.title', desc: 'team.benefit3.desc' },
    { icon: 'bi-person-check', title: 'team.benefit4.title', desc: 'team.benefit4.desc' },
];
const connectedFlow = [
    { icon: 'bi-cart-check', number: '01', title: 'flow.step1.title', desc: 'flow.step1.desc' },
    { icon: 'bi-kanban', number: '02', title: 'flow.step2.title', desc: 'flow.step2.desc' },
    { icon: 'bi-box-seam', number: '03', title: 'flow.step3.title', desc: 'flow.step3.desc' },
    { icon: 'bi-cash-stack', number: '04', title: 'flow.step4.title', desc: 'flow.step4.desc' },
];
const faqItems = Array.from({ length: 6 }, (_, index) => index + 1);
---

<!-- Core solutions -->
<section id="features" class="py-5 bg-dark-teal">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('feat.membership.subtitle')}</span>
            <h2 class="display-5 fw-bold text-neon mb-3">{t('feat.whatis.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 760px;">{t('feat.whatis.desc')}</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            {moduleCards.map((card) => (
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 rounded-4 h-100 p-4 card-neon-animated">
                        <i class={`bi ${card.icon} fs-1 text-neon mb-3`}></i>
                        <h5 class="text-white fw-bold">{t(card.title)}</h5>
                        <p class="text-light small mb-0">{t(card.desc)}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- How it works -->
<section class="workflow-section py-5 bg-sidebar">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('workflow.badge')}</span>
            <h2 class="display-5 fw-bold text-white mb-3">{t('workflow.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 760px;">{t('workflow.desc')}</p>
        </div>
        <div class="row g-4 justify-content-center">
            {workflowSteps.map((step) => (
                <div class="col-md-6 col-lg-3">
                    <article class="workflow-card h-100 rounded-4 p-4">
                        <span class="workflow-card__number">{step.number}</span>
                        <i class={`bi ${step.icon} workflow-card__icon`}></i>
                        <h3 class="h5 text-white fw-bold mt-4 mb-2">{t(step.title)}</h3>
                        <p class="text-light mb-0">{t(step.desc)}</p>
                    </article>
                </div>
            ))}
        </div>
    </div>
</section>

<DigitalCredential />

<!-- Sales with product control -->
<section class="inventory-section py-5 bg-sidebar">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('inventory.badge')}</span>
                <h2 class="display-5 fw-bold text-white mb-3">{t('inventory.title')}</h2>
                <p class="lead text-light mb-4">{t('inventory.desc')}</p>
                <div class="inventory-highlight rounded-4 p-4">
                    <i class="bi bi-cart-check-fill"></i>
                    <p class="mb-0">{t('inventory.highlight')}</p>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    {inventoryBenefits.map((benefit) => (
                        <div class="col-sm-6">
                            <article class="inventory-benefit h-100 rounded-4 p-4">
                                <i class={`bi ${benefit.icon} fs-2 text-neon mb-3`}></i>
                                <h3 class="h5 text-white fw-bold mb-2">{t(benefit.title)}</h3>
                                <p class="mb-0">{t(benefit.desc)}</p>
                            </article>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team and people -->
<section class="inventory-section py-5 bg-sidebar">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('team.badge')}</span>
            <h2 class="display-5 fw-bold text-white mb-3">{t('team.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 760px;">{t('team.desc')}</p>
        </div>
        <div class="row g-3 justify-content-center">
            {teamBenefits.map((benefit) => (
                <div class="col-sm-6 col-xl-3">
                    <article class="inventory-benefit h-100 rounded-4 p-4">
                        <i class={`bi ${benefit.icon} fs-2 text-neon mb-3`}></i>
                        <h3 class="h5 text-white fw-bold mb-2">{t(benefit.title)}</h3>
                        <p class="mb-0">{t(benefit.desc)}</p>
                    </article>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Connected operations -->
<section class="workflow-section py-5 bg-dark-teal">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="badge rounded-pill bg-primary text-dark px-3 py-2 mb-3">{t('flow.badge')}</span>
            <h2 class="display-5 fw-bold text-neon mb-3">{t('flow.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 760px;">{t('flow.desc')}</p>
        </div>
        <div class="row g-4 justify-content-center">
            {connectedFlow.map((step) => (
                <div class="col-md-6 col-xl-3">
                    <article class="workflow-card h-100 rounded-4 p-4">
                        <span class="workflow-card__number">{step.number}</span>
                        <i class={`bi ${step.icon} workflow-card__icon`}></i>
                        <h3 class="h5 text-white fw-bold mt-4 mb-2">{t(step.title)}</h3>
                        <p class="text-light mb-0">{t(step.desc)}</p>
                    </article>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Compatible sectors -->
<section class="py-5 bg-dark-teal">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-neon mb-3">{t('feat.agnostic.title')}</h2>
            <p class="lead text-light mx-auto mb-4" style="max-width: 800px;">{t('feat.agnostic.desc')}</p>
        </div>
        
        <div class="row g-3 justify-content-center">
            {nicheCards.map((card) => (
                <div class="col-md-6 col-lg-4">
                    <article class="niche-card h-100 rounded-4 border border-secondary border-opacity-10">
                        <div class="niche-card__icon" aria-hidden="true"><i class={`bi ${card.icon}`}></i></div>
                        <div class="niche-card__body">
                            <h3 class="text-white h5 fw-bold mb-2">{t(card.title)}</h3>
                            <p class="text-light mb-0">{t(card.flow)}</p>
                        </div>
                    </article>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Frequently asked questions -->
<section class="faq-section py-5 bg-sidebar">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-white mb-3">{t('faq.title')}</h2>
            <p class="lead text-light mx-auto" style="max-width: 720px;">{t('faq.desc')}</p>
        </div>
        <div class="faq-list mx-auto">
            {faqItems.map((item) => (
                <details class="faq-item">
                    <summary>{t(`faq.${item}.question`)}<i class="bi bi-plus-lg"></i></summary>
                    <p>{t(`faq.${item}.answer`)}</p>
                </details>
            ))}
        </div>
    </div>
</section>

<!-- Final call to action -->
<section class="final-cta py-5 bg-dark-teal">
    <div class="container py-5 text-center">
        <h2 class="display-5 fw-bold text-neon mb-3">{t('cta.final.title')}</h2>
        <p class="lead text-light mx-auto mb-4" style="max-width: 700px;">{t('cta.final.desc')}</p>
        <a
            href={`https://wa.me/59170668135?text=${encodeURIComponent(t('hero.whatsapp_message'))}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg px-4 py-3 rounded-pill shadow-lg"
        >{t('cta.final.button')} <i class="bi bi-arrow-right ms-2"></i></a>
    </div>
</section>



<style>
    .bg-dark-teal {
        background-color: var(--nav-color);
    }
    .hover-scale {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    }
    .hover-scale:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 243, 255, 0.15) !important;
        border-color: var(--neon-cyan) !important;
    }
    .feature-card:hover {
        background-color: rgba(5, 25, 33, 0.8) !important;
    }
    #features h2,
    #features h2,
    section.bg-dark-teal h2 {
        font-size: 2.35rem !important;
        line-height: 1.18;
    }
    #features .lead,
    #features .lead,
    section.bg-dark-teal .lead {
        font-size: 1.08rem;
        line-height: 1.5;
    }
    #features p,
    #features p,
    section.bg-dark-teal p {
        font-size: 1rem;
        line-height: 1.5;
    }
    #features .card h5 {
        font-size: 1.05rem;
        line-height: 1.3;
    }
    #features .card p.small {
        font-size: 0.95rem;
        line-height: 1.45;
    }
    .niche-card {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        background: rgba(5, 25, 33, 0.82);
        padding: 1.25rem;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .niche-card__icon {
        display: grid;
        flex: 0 0 3.25rem;
        width: 3.25rem;
        height: 3.25rem;
        place-items: center;
        border: 1px solid rgba(0, 255, 200, 0.25);
        border-radius: 1rem;
        background: rgba(0, 255, 200, 0.08);
        color: var(--active-color);
        font-size: 1.6rem;
    }
    .niche-card__body {
        flex: 1 1 auto;
        min-width: 0;
    }
    .niche-card h3 {
        font-size: 1.1rem;
        line-height: 1.3;
    }
    .niche-card p {
        color: #b7ced1 !important;
        font-size: 0.94rem;
        line-height: 1.5;
    }
    .niche-card:hover {
        transform: translateY(-5px);
        border-color: rgba(0, 255, 200, 0.6) !important;
        box-shadow: 0 12px 28px rgba(0, 243, 255, 0.12);
    }
    .workflow-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(0, 243, 255, 0.16);
        background: rgba(2, 16, 20, 0.58);
    }
    .workflow-card__number {
        color: rgba(0, 255, 200, 0.42);
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1;
    }
    .workflow-card__icon {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        color: var(--active-color);
        font-size: 2rem;
    }
    .workflow-card p {
        color: #b7ced1 !important;
        line-height: 1.55;
    }
    .inventory-section {
        border-top: 1px solid rgba(0, 243, 255, 0.1);
        border-bottom: 1px solid rgba(0, 243, 255, 0.1);
    }
    .inventory-highlight {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        border: 1px solid rgba(0, 255, 200, 0.35);
        background: rgba(0, 255, 200, 0.08);
        color: #d9ffef;
    }
    .inventory-highlight i {
        color: var(--active-color);
        font-size: 1.5rem;
    }
    .inventory-highlight p {
        line-height: 1.55;
    }
    .inventory-benefit {
        border: 1px solid rgba(0, 243, 255, 0.16);
        background: rgba(2, 16, 20, 0.58);
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .inventory-benefit p {
        color: #b7ced1;
        line-height: 1.55;
    }
    .inventory-benefit:hover {
        transform: translateY(-4px);
        border-color: rgba(0, 255, 200, 0.55);
        box-shadow: 0 10px 24px rgba(0, 243, 255, 0.1);
    }
    .faq-list {
        max-width: 860px;
    }
    .faq-item {
        margin-bottom: 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 0.8rem;
        background: rgba(2, 16, 20, 0.48);
    }
    .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.25rem;
        color: #fff;
        cursor: pointer;
        font-weight: 700;
        list-style: none;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary i { color: var(--active-color); transition: transform 0.2s ease; }
    .faq-item[open] summary i { transform: rotate(45deg); }
    .faq-item p {
        margin: 0;
        padding: 0 1.25rem 1.1rem;
        color: #b7ced1 !important;
        line-height: 1.6;
    }
    @media (max-width: 1199.98px) {
        #features h2,
        #features h2,
        section.bg-dark-teal h2 {
            font-size: 2rem !important;
        }
        #features .lead,
        #features .lead,
        section.bg-dark-teal .lead {
            font-size: 1rem;
        }
        #features p,
        #features p,
        section.bg-dark-teal p {
            font-size: 0.94rem;
        }
        #features .card h5,
        .niche-card h3 {
            font-size: 0.98rem !important;
        }
        #features .card p.small {
            font-size: 0.88rem;
        }
    }
    @media (max-width: 767.98px) {
        #features h2,
        #features h2,
        section.bg-dark-teal h2 {
            font-size: 1.55rem !important;
            line-height: 1.2;
        }
        #features .lead,
        #features .lead,
        section.bg-dark-teal .lead {
            font-size: 0.92rem !important;
            line-height: 1.45;
        }
        #features p,
        #features p,
        section.bg-dark-teal p {
            font-size: 0.88rem;
            line-height: 1.45;
        }
        #features .card h5,
        .niche-card h3 {
            font-size: 0.9rem !important;
            line-height: 1.25;
        }
        #features .card p.small {
            font-size: 0.82rem;
            line-height: 1.35;
        }
        .niche-card { padding: 1rem; gap: 0.75rem; }
        .niche-card__icon { flex-basis: 2.75rem; width: 2.75rem; height: 2.75rem; font-size: 1.35rem; border-radius: 0.8rem; }
        .niche-card p {
            font-size: 0.88rem;
        }
        .inventory-highlight {
            padding: 1rem !important;
        }
    }
</style>
