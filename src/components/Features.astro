---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Section 1: Problem vs Solution -->
<section id="features" class="py-5 bg-dark-teal pt-5"> 
    <div class="container py-5 mt-4">
        <div class="row align-items-center mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold text-neon mb-4">{t('feat.whatis.title')}</h2>
                <p class="lead text-light">{t('feat.whatis.desc')}</p>
                <p class="mb-5 text-light">{t('feat.whatis.p1')}</p>
            </div>
        </div>
        
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card card-neon-animated border-0 rounded-4">
                    <div class="card-body p-4 p-md-5">
                        
                        <!-- Item 1 -->
                        <div class="row align-items-center mb-4 pb-4 border-bottom border-secondary border-opacity-25">
                            <div class="col-md-5 mb-3 mb-md-0">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-x-circle fs-5 text-danger me-2"></i>
                                    <h5 class="text-white fw-bold mb-0">{t('feat.prob.1.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.prob.1.desc')}</p>
                            </div>
                            
                            <div class="col-md-2 text-center mb-3 mb-md-0">
                                <i class="bi bi-arrow-right fs-4 text-secondary opacity-50 d-none d-md-inline-block"></i>
                                <i class="bi bi-arrow-down fs-4 text-secondary opacity-50 d-inline-block d-md-none"></i>
                            </div>

                            <div class="col-md-5">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle fs-5 text-neon me-2"></i>
                                    <h5 class="text-neon fw-bold mb-0">{t('feat.sol.1.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.sol.1.desc')}</p>
                            </div>
                        </div>

                        <!-- Item 2 -->
                        <div class="row align-items-center mb-4 pb-4 border-bottom border-secondary border-opacity-25">
                            <div class="col-md-5 mb-3 mb-md-0">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-x-circle fs-5 text-danger me-2"></i>
                                    <h5 class="text-white fw-bold mb-0">{t('feat.prob.2.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.prob.2.desc')}</p>
                            </div>
                            
                            <div class="col-md-2 text-center mb-3 mb-md-0">
                                <i class="bi bi-arrow-right fs-4 text-secondary opacity-50 d-none d-md-inline-block"></i>
                                <i class="bi bi-arrow-down fs-4 text-secondary opacity-50 d-inline-block d-md-none"></i>
                            </div>

                            <div class="col-md-5">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle fs-5 text-neon me-2"></i>
                                    <h5 class="text-neon fw-bold mb-0">{t('feat.sol.2.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.sol.2.desc')}</p>
                            </div>
                        </div>

                        <!-- Item 3 -->
                        <div class="row align-items-center mb-4 pb-4 border-bottom border-secondary border-opacity-25">
                            <div class="col-md-5 mb-3 mb-md-0">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-x-circle fs-5 text-danger me-2"></i>
                                    <h5 class="text-white fw-bold mb-0">{t('feat.prob.3.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.prob.3.desc')}</p>
                            </div>
                            
