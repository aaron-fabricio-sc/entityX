                                <i class="bi bi-arrow-right fs-4 text-secondary opacity-50 d-none d-md-inline-block"></i>
                                <i class="bi bi-arrow-down fs-4 text-secondary opacity-50 d-inline-block d-md-none"></i>
                            </div>

                            <div class="col-md-5">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle fs-5 text-neon me-2"></i>
                                    <h5 class="text-neon fw-bold mb-0">{t('feat.sol.3.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.sol.3.desc')}</p>
                            </div>
                        </div>

                        <!-- Item 4 -->
                        <div class="row align-items-center mb-4 pb-4 border-bottom border-secondary border-opacity-25">
                            <div class="col-md-5 mb-3 mb-md-0">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-x-circle fs-5 text-danger me-2"></i>
                                    <h5 class="text-white fw-bold mb-0">{t('feat.prob.4.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.prob.4.desc')}</p>
                            </div>
                            
                            <div class="col-md-2 text-center mb-3 mb-md-0">
                                <i class="bi bi-arrow-right fs-4 text-secondary opacity-50 d-none d-md-inline-block"></i>
                                <i class="bi bi-arrow-down fs-4 text-secondary opacity-50 d-inline-block d-md-none"></i>
                            </div>

                            <div class="col-md-5">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle fs-5 text-neon me-2"></i>
                                    <h5 class="text-neon fw-bold mb-0">{t('feat.sol.4.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.sol.4.desc')}</p>
                            </div>
                        </div>

                        <!-- Item 5 -->
                        <div class="row align-items-center">
                            <div class="col-md-5 mb-3 mb-md-0">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-x-circle fs-5 text-danger me-2"></i>
                                    <h5 class="text-white fw-bold mb-0">{t('feat.prob.5.title')}</h5>
                                </div>
                                <p class="small text-light mb-0 ps-4 ms-1">{t('feat.prob.5.desc')}</p>
                            </div>
                            
                            <div class="col-md-2 text-center mb-3 mb-md-0">
                                <i class="bi bi-arrow-right fs-4 text-secondary opacity-50 d-none d-md-inline-block"></i>
                                <i class="bi bi-arrow-down fs-4 text-secondary opacity-50 d-inline-block d-md-none"></i>
                            </div>

                            <div class="col-md-5">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle fs-5 text-neon me-2"></i>
