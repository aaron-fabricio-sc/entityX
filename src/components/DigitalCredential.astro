---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const benefits = [1, 2, 3];
const steps = [1, 2, 3];
---

<section id="digital-credential" class="digital-credential-section py-5">
  <div class="container py-5">
    <div class="row align-items-center g-5">
      <div class="col-lg-5">
        <span class="badge rounded-pill credential-badge px-3 py-2 mb-3">
          <i class="bi bi-qr-code-scan me-2"></i>{t('credential.badge')}
        </span>
        <h2 class="display-5 fw-bold text-neon mb-3">{t('credential.title')}</h2>
        <p class="lead text-light mb-4">{t('credential.desc')}</p>
        <div class="credential-benefits">
          {benefits.map((benefit) => (
            <article class="credential-benefit">
              <i class={`bi ${benefit === 1 ? 'bi-lightning-charge-fill' : benefit === 2 ? 'bi-tablet' : 'bi-shield-check'} text-neon`}></i>
              <div>
                <h3>{t(`credential.benefit${benefit}.title`)}</h3>
                <p>{t(`credential.benefit${benefit}.desc`)}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="col-lg-7">
        <div class="credential-showcase card-neon-animated">
          <div class="credential-preview">
            <div class="credential-preview-top">
              <span><i class="bi bi-patch-check-fill me-2"></i>{t('credential.preview.eyebrow')}</span>
              <span class="credential-preview-status"><i class="bi bi-check-circle-fill me-1"></i>{t('credential.preview.active')}</span>
            </div>
            <div class="credential-preview-content">
              <div class="credential-preview-client">
                <div class="credential-preview-avatar"><i class="bi bi-person-fill"></i></div>
                <div>
                  <small>{t('credential.preview.client')}</small>
                  <strong>{t('credential.preview.name')}</strong>
                  <span>{t('credential.preview.plan')}</span>
                </div>
              </div>
              <div class="credential-preview-qr" aria-label={t('credential.preview.qr_alt')}>
                <i class="bi bi-qr-code"></i>
              </div>
            </div>
            <div class="credential-preview-footer">
              <i class="bi bi-clock-history me-2"></i>{t('credential.preview.temporary')}
            </div>
          </div>

          <div class="credential-steps">
            {steps.map((step) => (
              <article class="credential-step">
                <span class="credential-step-number">{step}</span>
                <div>
                  <h3>{t(`credential.step${step}.title`)}</h3>
                  <p>{t(`credential.step${step}.desc`)}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="credential-verification-note">
      <div class="credential-verification-intro">
        <span class="credential-verification-icon"><i class="bi bi-shield-check"></i></span>
        <div>
          <h3>{t('credential.verification.title')}</h3>
          <p>{t('credential.verification.desc')}</p>
        </div>
      </div>
      <div class="credential-verification-options">
        <article>
          <i class="bi bi-qr-code-scan"></i>
          <div>
            <h4>{t('credential.verification.qr.title')}</h4>
            <p>{t('credential.verification.qr.desc')}</p>
          </div>
        </article>
        <article>
          <i class="bi bi-person-vcard"></i>
          <div>
            <h4>{t('credential.verification.document.title')}</h4>
            <p>{t('credential.verification.document.desc')}</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .digital-credential-section { background: linear-gradient(135deg, #021014 0%, #062630 100%); }
  .credential-badge { color: #021014; background: var(--active-color); font-size: .85rem; font-weight: 700; }
  .credential-benefits { display: grid; gap: .85rem; }
  .credential-benefit { display: flex; align-items: flex-start; gap: .85rem; padding: .9rem; border: 1px solid rgba(148,163,184,.16); border-radius: 12px; background: rgba(2,16,20,.48); }
  .credential-benefit > i { flex: 0 0 auto; font-size: 1.2rem; line-height: 1.25; }
  .credential-benefit h3, .credential-step h3 { margin: 0 0 .2rem; color: #fff; font-size: 1rem; font-weight: 700; }
  .credential-benefit p, .credential-step p { margin: 0; color: #cbd5e1; font-size: .92rem; line-height: 1.45; }
  .credential-showcase { padding: 1.25rem; border-radius: 20px; background: rgba(5,25,33,.9); }
  .credential-preview { overflow: hidden; border: 1px solid rgba(0,243,255,.58); border-radius: 16px; background: linear-gradient(145deg, #071b34, #0b2940); }
  .credential-preview-top, .credential-preview-content, .credential-preview-footer { padding: 1rem 1.1rem; }
  .credential-preview-top { display: flex; align-items: center; justify-content: space-between; gap: .75rem; border-bottom: 1px solid rgba(0,243,255,.2); color: #8ff6e7; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .credential-preview-status { padding: .35rem .55rem; border: 1px solid #48e5ad; border-radius: 999px; color: #a7f3d0; background: rgba(16,185,129,.14); font-size: .67rem; letter-spacing: 0; text-transform: none; white-space: nowrap; }
  .credential-preview-content { display: grid; grid-template-columns: minmax(0,1fr) 140px; align-items: center; gap: 1rem; }
  .credential-preview-client { display: flex; align-items: center; gap: .8rem; min-width: 0; }
  .credential-preview-avatar { display: grid; width: 54px; height: 54px; flex: 0 0 54px; place-items: center; border: 2px solid #41d8c1; border-radius: 50%; color: #fff; background: linear-gradient(135deg,#0e7490,#134e4a); font-size: 1.45rem; }
  .credential-preview-client small, .credential-preview-client span { display: block; color: #77ead9; font-size: .76rem; }
  .credential-preview-client small { margin-bottom: .15rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .credential-preview-client strong { display: block; overflow-wrap: anywhere; color: #fff; font-size: 1.15rem; }
  .credential-preview-client span { margin-top: .2rem; }
  .credential-preview-qr { display: grid; width: 140px; height: 140px; place-items: center; border-radius: 10px; color: #020617; background: linear-gradient(90deg,rgba(2,6,23,.14) 1px,transparent 1px) 0 0/11px 11px, linear-gradient(rgba(2,6,23,.14) 1px,transparent 1px) 0 0/11px 11px,#fff; }
  .credential-preview-qr i { padding: .4rem; color: #020617; background: #fff; font-size: 5.5rem; line-height: 1; }
  .credential-preview-footer { border-top: 1px solid rgba(148,163,184,.16); color: #8ff6e7; font-size: .78rem; text-align: center; }
  .credential-steps { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .75rem; margin-top: 1rem; }
  .credential-step { display: flex; align-items: flex-start; gap: .55rem; min-width: 0; }
  .credential-step-number { display: grid; width: 24px; height: 24px; flex: 0 0 24px; place-items: center; border-radius: 50%; color: #021014; background: #00f3ff; font-size: .75rem; font-weight: 800; }
  .credential-step h3 { font-size: .88rem; }
  .credential-step p { font-size: .79rem; }
  .credential-verification-note { display: grid; gap: 1rem; margin-top: 2.5rem; padding: 1.35rem; border: 1px solid rgba(0,243,255,.5); border-radius: 18px; background: linear-gradient(135deg,rgba(7,27,52,.96),rgba(11,41,64,.96)); box-shadow: 0 12px 28px rgba(0,0,0,.2); }
  .credential-verification-intro { display: flex; align-items: flex-start; gap: .85rem; }
  .credential-verification-icon { display: grid; width: 38px; height: 38px; flex: 0 0 38px; place-items: center; border-radius: 11px; color: #021014; background: #00f3ff; font-size: 1.1rem; }
  .credential-verification-intro h3 { margin: 0 0 .2rem; color: #fff !important; font-size: 1.1rem; font-weight: 700; }
  .credential-verification-intro p { margin: 0; color: #d8f7f3 !important; font-size: .92rem; line-height: 1.45; }
  .credential-verification-options { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .85rem; }
  .credential-verification-options article { display: flex; align-items: flex-start; gap: .7rem; min-width: 0; padding: .9rem; border: 1px solid rgba(143,246,231,.28); border-radius: 12px; background: rgba(2,16,20,.34); }
  .credential-verification-options article > i { flex: 0 0 auto; color: #00f3ff; font-size: 1.25rem; }
  .credential-verification-options h4 { margin: 0 0 .2rem; color: #8ff6e7 !important; font-size: .95rem; font-weight: 700; }
  .credential-verification-options p { margin: 0; color: #e2f4f1 !important; font-size: .84rem; line-height: 1.45; }
  @media (max-width: 991.98px) { .credential-showcase { max-width: 680px; margin: 0 auto; } }
  @media (max-width: 575.98px) {
    .credential-showcase { padding: .8rem; border-radius: 14px; }
    .credential-preview-top, .credential-preview-content, .credential-preview-footer { padding: .8rem; }
    .credential-preview-content { grid-template-columns: minmax(0,1fr) 106px; gap: .7rem; }
    .credential-preview-avatar { width: 44px; height: 44px; flex-basis: 44px; font-size: 1.1rem; }
    .credential-preview-client strong { font-size: .95rem; }
    .credential-preview-qr { width: 106px; height: 106px; background-size: 8px 8px; }
    .credential-preview-qr i { font-size: 4rem; }
    .credential-steps { grid-template-columns: 1fr; }
    .credential-verification-note { grid-template-columns: 1fr; gap: 1rem; margin-top: 1.5rem; padding: 1rem; }
    .credential-verification-options { grid-template-columns: 1fr; }
  }
</style>
