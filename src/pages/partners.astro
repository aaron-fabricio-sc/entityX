---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { useTranslations } from "../i18n/utils";

const lang = "es";
const t = useTranslations(lang);
---

<Layout
  title={t("seo.partners.title")}
  description={t("seo.partners.desc")}
  keywords={t("seo.partners.keywords")}
>
  <Navbar />

  <main class="pt-4 mt-5">
    <!-- Hero Section -->
    <section
      class="py-5 text-center text-white bg-dark-teal position-relative overflow-hidden"
    >
      <div class="container py-5 position-relative z-1">
        <span class="badge rounded-pill bg-info text-dark mb-3"
          >{t("partners.badge")}</span
        >
        <h1 class="fw-bold text-gradient mb-4 responsive-partner-title">
          {t("partners.hero.title")}
        </h1>
        <p
          class="mx-auto text-light responsive-partner-desc"
          style="max-width: 800px;"
        >
          {t("partners.hero.desc")}
        </p>
      </div>
      <!-- Abstract Background Decoration -->
      <div
        class="position-absolute top-0 start-0 w-100 h-100 opacity-25"
        style="background: radial-gradient(circle at 50% 50%, #00ffc8 0%, transparent 50%);"
      >
      </div>
    </section>

    <!-- Features List -->
    <section class="py-5 bg-sidebar">
      <div class="container">
        <div class="row g-5 align-items-center">
          <div class="col-lg-6">
            <img
              src={import.meta.env.BASE_URL + "imagenes/Mejora_calidad_de_imagen_202607061132.jpeg"}
              class="img-fluid rounded-4 shadow-lg mb-4"
              alt="Programa de aliados EntityX para vender software de gestión deportiva"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="col-lg-6">
            <div class="card card-neon-animated border-0 p-4 mb-4 bg-sidebar text-light flex-row align-items-center">
              <div class="flex-shrink-0 me-4">
                <i class="bi bi-mortarboard fs-1 text-neon"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <h3 class="h4">{t("partners.list1.title")}</h3>
                <p class="">{t("partners.list1.desc")}</p>
              </div>
            </div>
            <div class="card card-neon-animated border-0 p-4 mb-4 bg-sidebar text-light flex-row align-items-center">
              <div class="flex-shrink-0 me-4">
                <i class="bi bi-speedometer2 fs-1 text-neon"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <h3 class="h4">{t("partners.list2.title")}</h3>
                <p class="">{t("partners.list2.desc")}</p>
              </div>
            </div>
            <div class="card card-neon-animated border-0 p-4 mb-4 bg-sidebar text-light flex-row align-items-center">
              <div class="flex-shrink-0 me-4">
                <i class="bi bi-people fs-1 text-neon"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <h3 class="h4">{t("partners.list3.title")}</h3>
                <p class="">{t("partners.list3.desc")}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-5 align-items-center mt-4">
          <div class="col-lg-6 order-lg-2">
            <img
              src={import.meta.env.BASE_URL + "imagenes/Mejora_calidad_de_imagen_202607061134.jpeg"}
              class="img-fluid rounded-4 shadow-lg mb-4"
              alt="Panel de comisiones y seguimiento comercial para aliados EntityX"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="col-lg-6 order-lg-1">
            <div class="card card-neon-animated border-0 p-4 mb-4 bg-sidebar text-light flex-row align-items-center">
              <div class="flex-shrink-0 me-4">
                <i class="bi bi-wallet2 fs-1 text-neon"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <h3 class="h4">{t("partners.list4.title")}</h3>
                <p class="">{t("partners.list4.desc")}</p>
              </div>
            </div>
            <div class="card card-neon-animated border-0 p-4 mb-4 bg-sidebar text-light flex-row align-items-center">
              <div class="flex-shrink-0 me-4">
                <i class="bi bi-briefcase fs-1 text-neon"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <h3 class="h4">{t("partners.list5.title")}</h3>
                <p class="">{t("partners.list5.desc")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-5 bg-dark-teal text-center">
      <div class="container">
        <h2 class="text-gradient mb-4">{t("partners.cta.title")}</h2>
        <a
          href="https://wa.me/59170668135?text=Hola!%20%F0%9F%91%8B%20estoy%20interesado%20en%20el%20programa%20de%20asociados%20de%20EntityX%20%F0%9F%9A%80"
          target="_blank"
          class="btn btn-primary rounded-pill shadow-lg responsive-cta-btn"
        >
          <i class="bi bi-whatsapp me-2"></i>
          {t("partners.cta.button")}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style lang="scss">
  @use "../styles/variables" as vars;

  .text-gradient {
    background: linear-gradient(
      120deg,
      vars.$text-light 0%,
      vars.$active-color 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .responsive-partner-title {
    font-size: 2.25rem;
    line-height: 1.15;
  }

  .responsive-partner-desc {
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .responsive-cta-btn {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
  }
  main h2 {
    font-size: 2.35rem;
    line-height: 1.18;
  }
  main h3 {
    font-size: 1.05rem;
    line-height: 1.3;
  }
  main p {
    font-size: 0.95rem;
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .responsive-partner-title {
      font-size: 3.25rem;
    }

    .responsive-partner-desc {
      font-size: 1.25rem;
    }

    .responsive-cta-btn {
      padding: 1rem 3rem;
      font-size: 1.1rem;
    }
  }

  @media (min-width: 1200px) {
    .responsive-partner-title {
      font-size: 3.75rem;
    }

    .responsive-partner-desc {
      font-size: 1.35rem;
    }
  }

  @media (max-width: 1199.98px) {
    main > section.py-5 {
      padding-top: 2.5rem !important;
      padding-bottom: 2.5rem !important;
    }
    main .container.py-5 {
      padding-top: 2.5rem !important;
      padding-bottom: 2.5rem !important;
    }
    .row.g-5 {
      --bs-gutter-x: 1.5rem;
      --bs-gutter-y: 1.5rem;
    }
    .responsive-partner-title {
      font-size: 2.8rem;
    }
    .responsive-partner-desc {
      font-size: 1.1rem;
    }
    main h2 {
      font-size: 2rem;
    }
    main h3 {
      font-size: 0.98rem;
    }
    main p {
      font-size: 0.88rem;
    }
    .card.p-4 {
      padding: 1.25rem !important;
      margin-bottom: 1rem !important;
    }
    .card .fs-1 {
      font-size: 1.75rem !important;
    }
  }

  @media (max-width: 991.98px) {
    .responsive-partner-title {
      font-size: 2.35rem;
    }
    .responsive-partner-desc {
      font-size: 1rem;
    }
    main h2 {
      font-size: 1.75rem;
    }
    main h3 {
      font-size: 0.92rem;
    }
    main p {
      font-size: 0.82rem;
      line-height: 1.4;
    }
    .card.p-4 {
      padding: 1rem !important;
      margin-bottom: 0.85rem !important;
    }
    .flex-grow-1.ms-3 {
      margin-left: 0.75rem !important;
    }
    .flex-shrink-0.me-4 {
      margin-right: 0.75rem !important;
    }
    .responsive-cta-btn {
      padding: 0.72rem 1.6rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 575.98px) {
    main > section.py-5 {
      padding-top: 1.75rem !important;
      padding-bottom: 1.75rem !important;
    }
    main .container.py-5 {
      padding-top: 1.75rem !important;
      padding-bottom: 1.75rem !important;
    }
    .responsive-partner-title {
      font-size: 1.8rem;
      line-height: 1.18;
    }
    .responsive-partner-desc {
      font-size: 0.92rem;
    }
    main h2 {
      font-size: 1.45rem;
      margin-bottom: 1rem !important;
    }
    main h3 {
      font-size: 0.86rem;
      margin-bottom: 0.35rem;
    }
    main p {
      font-size: 0.78rem;
      line-height: 1.35;
      margin-bottom: 0;
    }
    .card.p-4 {
      padding: 0.9rem !important;
    }
    .card .fs-1 {
      font-size: 1.35rem !important;
    }
    .responsive-cta-btn {
      width: 100%;
      padding: 0.65rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>
