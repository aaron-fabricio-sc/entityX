---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    {params: {lang: 'en'}},
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'es' | 'en');

// Fallback translating for skeleton using lang checking since `pricing.loading` isn't in en/es dictionaries
const loadingText = lang === 'en' ? 'Loading...' : 'Cargando...';

let plans: any[] = [
  { name: loadingText, clients: "...", monthly: "...", yearly: "...", featured: false, id: "plan-0" },
  { name: loadingText, clients: "...", monthly: "...", yearly: "...", featured: false, id: "plan-1" },
  { name: loadingText, clients: "...", monthly: "...", yearly: "...", featured: false, id: "plan-2" },
  { name: loadingText, clients: "...", monthly: "...", yearly: "...", featured: true,  id: "plan-3" },
  { name: loadingText, clients: "...", monthly: "...", yearly: "...", featured: false, id: "plan-4" },
  { name: loadingText, clients: "...", monthly: "...", yearly: "...", featured: false, id: "plan-5" }
];

const features = [
    { icon: 'bi-card-checklist', title: t('pricing.inc1.title'), desc: t('pricing.inc1.desc') },
    { icon: 'bi-stoplights', title: t('pricing.inc2.title'), desc: t('pricing.inc2.desc') },
    { icon: 'bi-person-badge', title: t('pricing.inc3.title'), desc: t('pricing.inc3.desc') },
    { icon: 'bi-cart-plus', title: t('pricing.inc4.title'), desc: t('pricing.inc4.desc') },
    { icon: 'bi-clock-history', title: t('pricing.inc5.title'), desc: t('pricing.inc5.desc') },
    { icon: 'bi-shield-lock', title: t('pricing.inc6.title'), desc: t('pricing.inc6.desc') },
];
---

<Layout 
  title={t('seo.pricing.title')}
  description={t('seo.pricing.desc')}
  keywords={t('seo.pricing.keywords')}
>
    <Navbar />
    
    <main class="pt-5 mt-5">
        <!-- Hero Section -->
        <section class="py-5 bg-dark-teal text-light text-center">
            <div class="container">
                <h1 class="text-neon mb-4 responsive-title">{t('pricing.title')}</h1>
                <p class="text-light mx-auto mb-4 responsive-desc" style="max-width: 800px;">{t('pricing.desc')}</p>
                
                <div class="alert alert-info bg-sidebar border-info text-info mx-auto" style="max-width: 700px;">
                    <i class="bi bi-info-circle-fill me-2"></i> {t('pricing.note')}
                </div>
            </div>
        </section>

        <!-- Pricing Table -->
        <section class="py-5 bg-body">
            <div class="container">
                <h2 class="text-center mb-5">{t('pricing.subtitle')}</h2>
                
                <div class="row g-4 justify-content-center">
                    {plans.map((plan, index) => (
                        <div class="col-md-6 col-lg-4" data-plan-index={index}>
                             <div class={`card h-100 bg-sidebar border-0 shadow-sm text-center feature-card plan-card ${plan.featured ? 'border-primary' : ''}`}>
                                <div class="card-header bg-transparent border-0 pt-4">
                                     {plan.featured && <span class="badge bg-primary mb-2 plan-badge">{t('pricing.badge.popular')}</span>}
                                    <h4 class="text-neon plan-name">{plan.name || "..."}</h4>
                                    <p class="text-light small">{t('pricing.clients_up_to')} <span class="plan-clients">{plan.clients}</span> {t('pricing.clients_label')}</p>
                                </div>
                                <div class="card-body">
                                    <h2 class="card-title display-6 fw-bold text-white mb-0 plan-monthly">{plan.monthly}</h2>
                                    <p class="text-secondary small mb-3">{t('pricing.table.monthly')}</p>
                                    
                                     <h3 class="card-title h4 text-success mb-0 plan-yearly">{plan.yearly}</h3>
                                     <p class="text-secondary small">{t('pricing.table.yearly')}</p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pb-4">
                                     <a href="#" target="_blank" class={`btn w-100 plan-cta ${plan.featured ? 'btn-primary' : 'btn-outline-primary'}`}>
                                        <i class="bi bi-whatsapp me-2"></i> {t('pricing.cta.choose')}
                                     </a>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <!-- Cards for mobile (visible only on small screens if needed, or stick to responsive table) -->
            </div>
        </section>

        <!-- What includes -->
        <section class="py-5 bg-dark-teal text-light">
            <div class="container">
                <h2 class="text-center text-gradient mb-5">{t('pricing.includes.title')}</h2>
                <div class="row g-4">
                    {features.map(f => (
                        <div class="col-md-6 col-lg-4">
                            <div class="d-flex align-items-start p-4 border border-secondary rounded-4 h-100 bg-sidebar hover-scale pricing-include-card">
                                <i class={`bi ${f.icon} fs-2 text-neon me-3`}></i>
                                <div>
                                    <h5 class={`text-white ${f.desc ? 'mb-2' : 'mb-0'}`}>{f.title}</h5>
                                    {f.desc && <p class="text-secondary small mb-0">{f.desc}</p>}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Why Annual & Flexibility -->
        <section class="py-5 bg-body">
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-4">
                        <div class="p-5 bg-sidebar rounded-4 shadow-sm border border-success h-100">
                             <h3 class="text-success mb-4"><i class="bi bi-calendar-check me-2"></i> {t('pricing.annual.title')}</h3>
                             <p class="text-light small">{t('pricing.annual.desc')}</p>
                        </div>
                    </div>
                    <div class="col-lg-4">
                         <div class="p-5 bg-sidebar rounded-4 shadow-sm border border-primary h-100">
                             <h3 class="text-primary mb-4"><i class="bi bi-arrows-expand me-2"></i> {t('pricing.flex.title')}</h3>
                             <p class="text-light small">{t('pricing.flex.desc')}</p>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="p-5 bg-sidebar rounded-4 shadow-sm border border-info h-100">
                            <h3 class="text-info mb-4"><i class="bi bi-eye me-2"></i> {t('pricing.transparency.title')}</h3>
                            <p class="text-light small">{t('pricing.transparency.desc')}</p>
                       </div>
                   </div>
                </div>
            </div>
        </section>

    </main>

    <Footer />
</Layout>

<style>
    .responsive-title {
        font-size: 2.25rem;
        font-weight: 700;
        line-height: 1.15;
    }
    .responsive-desc {
        font-size: 1.05rem;
        line-height: 1.5;
    }
    main h2 {
        font-size: 2.35rem;
        line-height: 1.18;
    }
    main h3 {
        font-size: 1.35rem;
        line-height: 1.25;
    }
    main h4,
    main h5 {
        font-size: 1.05rem;
        line-height: 1.3;
    }
    main p,
    main .small {
        font-size: 0.95rem;
        line-height: 1.45;
    }

    .plan-card .card-header,
    .plan-card .card-body,
    .plan-card .card-footer {
        margin: 0;
    }
    .plan-card h2,
    .plan-card h3,
    .plan-card h4,
    .plan-card p,
    .plan-card .badge {
        margin: 0 !important;
    }
    .plan-card .mb-3 {
        margin-bottom: 0.45rem !important;
    }
    .plan-card .plan-badge {
        margin-bottom: 0.35rem !important;
    }
    .plan-card .plan-name {
        margin-bottom: 0.35rem !important;
    }
    .plan-card .plan-monthly {
        margin-bottom: 0 !important;
    }
    .plan-card .plan-yearly {
        margin-bottom: 0 !important;
    }
    .plan-card .card-body .small {
        margin-bottom: 0.4rem !important;
    }
    .plan-card .card-footer {
        padding-top: 0 !important;
    }
    
    @media (min-width: 768px) {
        .responsive-title {
            font-size: 3.25rem;
            font-weight: 700;
        }
        .responsive-desc {
            font-size: 1.25rem;
        }
    }

    @media (min-width: 1200px) {
        .responsive-title {
            font-size: 3.75rem;
        }
        .responsive-desc {
            font-size: 1.35rem;
        }
    }

    @media (max-width: 1199.98px) {
        main > section.py-5 {
            padding-top: 2.5rem !important;
            padding-bottom: 2.5rem !important;
        }
        .container {
            max-width: 960px;
        }
        .row.g-4 {
            --bs-gutter-x: 1rem;
            --bs-gutter-y: 1rem;
        }
        .row.g-5 {
            --bs-gutter-x: 1.25rem;
            --bs-gutter-y: 1.25rem;
        }
        .responsive-title {
            font-size: 2.8rem;
            line-height: 1.15;
            margin-bottom: 1.15rem !important;
        }
        .responsive-desc {
            font-size: 1.1rem;
            margin-bottom: 1.15rem !important;
        }
        h2.mb-5,
        .text-gradient.mb-5 {
            margin-bottom: 2rem !important;
        }
        main h2 {
            font-size: 2rem;
        }
        main h3 {
            font-size: 1.2rem;
        }
        main h4,
        main h5 {
            font-size: 0.98rem;
        }
        main p,
        main .small {
            font-size: 0.88rem;
        }
        .plan-card {
            min-height: 0;
        }
        .plan-card.card {
            border-radius: 0.85rem;
        }
        .plan-card .card-header {
            padding: 0.9rem 0.85rem 0.25rem !important;
        }
        .plan-card .card-body {
            padding: 0.55rem 0.85rem;
        }
        .plan-card .card-footer {
            padding: 0.1rem 0.85rem 0.9rem !important;
        }
        .plan-card .card-header p {
            font-size: 0.88rem !important;
            line-height: 1.3;
            margin-bottom: 0.5rem !important;
        }
        .plan-badge {
            font-size: 0.72rem;
            padding: 0.32rem 0.5rem;
        }
        .plan-name {
            font-size: 1rem;
            margin-bottom: 0.45rem;
        }
        .plan-monthly {
            font-size: 1.65rem;
        }
        .plan-yearly {
            font-size: 1.05rem;
        }
        .plan-card .text-secondary.small {
            font-size: 0.78rem;
            margin-bottom: 0.5rem !important;
        }
        .plan-cta {
            font-size: 0.88rem;
            padding-top: 0.45rem;
            padding-bottom: 0.45rem;
        }
        .p-5.bg-sidebar {
            padding: 2rem !important;
        }
        .row .p-4 {
            padding: 1.35rem !important;
        }
        .p-5.bg-sidebar h3 {
            font-size: 1.35rem;
        }
    }

    @media (max-width: 991.98px) {
        main {
            margin-top: 3.5rem !important;
        }
        .container {
            max-width: 720px;
        }
        .row.g-4,
        .row.g-5 {
            --bs-gutter-x: 0.9rem;
            --bs-gutter-y: 0.9rem;
        }
        .responsive-title {
            font-size: 2.35rem;
            margin-bottom: 0.9rem !important;
        }
        .responsive-desc {
            font-size: 1rem;
            margin-bottom: 0.9rem !important;
        }
        h2.mb-5,
        .text-gradient.mb-5 {
            margin-bottom: 1.5rem !important;
        }
        main h2 {
            font-size: 1.75rem;
            line-height: 1.2;
        }
        main h3 {
            font-size: 1.08rem;
        }
        main h4,
        main h5 {
            font-size: 0.92rem;
        }
        main p,
        main .small {
            font-size: 0.82rem;
            line-height: 1.4;
        }
        .alert {
            font-size: 0.92rem;
            padding: 0.85rem 1rem;
            margin-bottom: 0 !important;
        }
        .plan-card .card-header {
            padding: 0.8rem 0.75rem 0.2rem !important;
        }
        .plan-card .card-body {
            padding: 0.45rem 0.75rem;
        }
        .plan-card .card-footer {
            padding: 0.05rem 0.75rem 0.8rem !important;
        }
        .plan-card p {
            margin-bottom: 0.4rem !important;
        }
        .plan-name {
            font-size: 0.95rem;
        }
        .plan-monthly {
            font-size: 1.45rem;
        }
        .plan-yearly {
            font-size: 1rem;
        }
        .row .p-4 {
            padding: 1.1rem !important;
        }
        h5 {
            font-size: 1rem;
            line-height: 1.35;
        }
        .pricing-include-card h5 {
            font-size: 0.92rem;
            line-height: 1.3;
        }
        .p-5.bg-sidebar {
            padding: 1.5rem !important;
        }
        .p-5.bg-sidebar h3 {
            font-size: 1.18rem;
            margin-bottom: 1rem !important;
        }
    }

    @media (max-width: 575.98px) {
        main > section.py-5 {
            padding-top: 1.55rem !important;
            padding-bottom: 1.55rem !important;
        }
        .container {
            padding-left: 1rem;
            padding-right: 1rem;
        }
        .row.g-4,
        .row.g-5 {
            --bs-gutter-y: 0.75rem;
        }
        .responsive-title {
            font-size: 1.8rem;
        }
        .responsive-desc {
            font-size: 0.92rem;
        }
        h2 {
            font-size: 1.45rem;
            margin-bottom: 1.15rem !important;
        }
        main h3 {
            font-size: 1rem;
        }
        main h4,
        main h5 {
            font-size: 0.86rem;
            line-height: 1.25;
        }
        main p,
        main .small {
            font-size: 0.78rem;
            line-height: 1.35;
        }
        .plan-card .card-header {
            padding: 0.7rem 0.65rem 0.15rem !important;
        }
        .plan-card .card-body {
            padding: 0.35rem 0.65rem;
        }
        .plan-card .card-footer {
            padding: 0 0.65rem 0.7rem !important;
        }
        .plan-card p {
            margin-bottom: 0.45rem !important;
        }
        .plan-name {
            font-size: 0.95rem;
            margin-bottom: 0.35rem;
        }
        .plan-monthly {
            font-size: 1.35rem;
        }
        .plan-yearly {
            font-size: 0.95rem;
        }
        .plan-cta {
            padding-top: 0.55rem;
            padding-bottom: 0.55rem;
            font-size: 0.86rem;
        }
        .plan-card .card-header p {
            font-size: 0.8rem !important;
        }
        .plan-card .text-secondary.small {
            font-size: 0.72rem;
        }
        .row .p-4 {
            padding: 0.9rem !important;
        }
        .pricing-include-card h5 {
            font-size: 0.84rem;
            line-height: 1.25;
        }
        .pricing-include-card i {
            font-size: 1.35rem !important;
            margin-right: 0.65rem !important;
        }
        .p-5.bg-sidebar {
            padding: 1rem !important;
        }
        .p-5.bg-sidebar h3 {
            font-size: 1.05rem;
            margin-bottom: 0.65rem !important;
        }
        .p-5.bg-sidebar p {
            font-size: 0.88rem;
            line-height: 1.45;
        }
    }

    .hover-scale {
        transition: transform 0.3s ease;
    }
    .hover-scale:hover {
        transform: translateY(-5px);
        border-color: var(--neon-cyan) !important;
    }

    /* Skeleton loading animation */
    .skeleton-text {
        display: inline-block;
        min-height: 1em;
        min-width: 50%;
        background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        border-radius: 4px;
        color: transparent !important;
    }

    @keyframes loading {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }
</style>

<script>
  const API_URL = "https://api.entityx.tech/api";

  async function fetchPlans() {
    try {
      // Add skeleton classes to placeholders while fetching
      const placeholders = document.querySelectorAll('.plan-name, .plan-clients, .plan-monthly, .plan-yearly');
      placeholders.forEach(el => {
        if (el.textContent === "...") el.classList.add('skeleton-text');
      });

      const response = await fetch(`${API_URL}/plans/public?currency=BOB`);
      if (response.ok) {
        const data = await response.json();
        
        if (Array.isArray(data) && data.length > 0) {
          data.forEach((d: any, index: number) => {
            const formatNumber = (num: number) => {
              if (!num) return "0";
              return num.toLocaleString('es-BO').replace(',', '.');
            };

            const isFeatured = d.max_clients === 250;
            const container = document.querySelector(`[data-plan-index="${index}"]`);
            
            if (container) {
              // Update content structure
              const nameEl = container.querySelector('.plan-name');
              const clientsEl = container.querySelector('.plan-clients');
              const monthlyEl = container.querySelector('.plan-monthly');
              const yearlyEl = container.querySelector('.plan-yearly');
              const ctaEl = container.querySelector('.plan-cta') as HTMLAnchorElement;
              const cardEl = container.querySelector('.plan-card');

              if (nameEl) {
                nameEl.textContent = d.name;
                nameEl.classList.remove('skeleton-text');
              }
              if (clientsEl) {
                clientsEl.textContent = d.max_clients;
                clientsEl.classList.remove('skeleton-text');
              }
              if (monthlyEl) {
                monthlyEl.textContent = `${formatNumber(Number(d.price_monthly))} ${d.currency}`;
                monthlyEl.classList.remove('skeleton-text');
              }
              if (yearlyEl) {
                yearlyEl.textContent = `${formatNumber(Number(d.price_yearly))} ${d.currency}`;
                yearlyEl.classList.remove('skeleton-text');
              }
              
              if (ctaEl) {
                ctaEl.href = `https://wa.me/59170668135?text=Hola,%20estoy%20interesado%20en%20el%20${encodeURIComponent(d.name)}`;
              }

              if (cardEl && isFeatured) {
                cardEl.classList.add('border-primary');
              }
            }
          });
        }
      }
    } catch (error) {
      console.error("Error fetching plans from API:", error);
    }
  }

  // Fetch plans on initial load
  document.addEventListener('DOMContentLoaded', fetchPlans);
</script>
