---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PurposeStatement from '../../components/PurposeStatement.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const pillars = [
  { icon: 'bi-universal-access', title: 'Accessible management', description: 'A cloud platform that brings order to operations without requiring costly infrastructure or advanced technical knowledge.' },
  { icon: 'bi-diagram-3-fill', title: 'Connected information', description: 'Clients, collections, sales, staff, and reports brought together so every business can work from one reliable source of information.' },
  { icon: 'bi-rocket-takeoff-fill', title: 'Sustainable growth', description: 'A core that can evolve into compatible sectors without losing focus on daily operational control.' },
];
---

<Layout title="Vision | EntityX" description="EntityX's vision: be the technology partner for small and medium-sized businesses to organize operations and grow.">
  <Navbar />
  <PurposeStatement
    eyebrow="The EntityX horizon"
    title="Our vision"
    statementLabel="Where we are going"
    statement="Make EntityX the technology partner for small and medium-sized businesses seeking to professionalize operations, centralize information, and grow without relying on costly tools or fragmented processes."
    statementImage="/imagenes/entityx-vision-fondo.png"
    pillars={pillars}
    pillarsEyebrow="How we make it real"
    pillarsTitle="A direction with daily impact."
    homeLabel="Back to home"
    homeHref="/en/"
    nextLabel="Discover our mission"
    nextHref="/en/mission"
  />
  <Footer />
</Layout>
