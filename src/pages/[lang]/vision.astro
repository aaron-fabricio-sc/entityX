---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PurposeStatement from '../../components/PurposeStatement.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const pillars = [
  { icon: 'bi-universal-access', title: 'Easy to use', description: 'A simple tool to organize a business without special equipment or technical knowledge.' },
  { icon: 'bi-diagram-3-fill', title: 'Clearer information', description: 'Customers, sales, products, teams, and accounts together so everyone knows where to find things.' },
  { icon: 'bi-rocket-takeoff-fill', title: 'Grow with order', description: 'Support each business as it adds customers, products, branches, and new ways of working.' },
];
---

<Layout title="Vision | EntityX" description="EntityX's vision is to help small and medium-sized businesses stay organized and grow with confidence.">
  <Navbar />
  <PurposeStatement
    eyebrow="The EntityX horizon"
    title="Our vision"
    statementLabel="Where we are going"
    statement="Be a trusted tool for small and medium-sized businesses that want to organize customers, sales, products, and teams, and grow without relying on paperwork or scattered information."
    statementImage="/imagenes/entityx-vision-fondo.png"
    pillars={pillars}
    pillarsEyebrow="How we make it real"
    pillarsTitle="A direction with daily impact."
    homeLabel="Back to home"
    homeHref="/en/"
    nextLabel="Discover our mission"
    nextHref="/en/mission"
  />
  <Footer />
</Layout>
