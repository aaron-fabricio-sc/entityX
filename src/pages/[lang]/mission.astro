---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PurposeStatement from '../../components/PurposeStatement.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const pillars = [
  { icon: 'bi-diagram-3-fill', title: 'Keep everything in one place', description: 'Bring together information that may be scattered across notebooks, files, receipts, and messages.' },
  { icon: 'bi-clipboard2-check', title: 'Make daily work easier', description: 'Help owners and teams write down, find, and organize what they do each day.' },
  { icon: 'bi-bar-chart-line', title: 'Make better decisions', description: 'Clearly show customers, sales, and money so owners know what is happening and what to do next.' },
];
---

<Layout title="Mission | EntityX" description="EntityX's mission is to help small and medium-sized businesses organize customers, sales, products, and daily work.">
  <Navbar />
  <PurposeStatement
    eyebrow="EntityX purpose"
    title="Our mission"
    statementLabel="Our reason for being"
    statement="Help small and medium-sized businesses organize their customers, sales, products, team, and daily work so they know what is happening in their business and can make confident decisions."
    statementImage="/imagenes/entityx-mision-fondo.png?v=2"
    pillars={pillars}
    pillarsEyebrow="How we make it real"
    pillarsTitle="A direction with daily impact."
    homeLabel="Back to home"
    homeHref="/en/"
    nextLabel="Discover our vision"
    nextHref="/en/vision"
  />
  <Footer />
</Layout>
