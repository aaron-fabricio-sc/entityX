---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PurposeStatement from '../../components/PurposeStatement.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const pillars = [
  { icon: 'bi-diagram-3-fill', title: 'Centralize what matters', description: 'Bring together information that is often scattered across notebooks, files, receipts, and messages.' },
  { icon: 'bi-clipboard2-check', title: 'Simplify daily control', description: 'Give owners and teams a simple way to record, consult, and follow up on everyday operations.' },
  { icon: 'bi-bar-chart-line', title: 'Decide with confidence', description: 'Turn client, collection, sales, and activity data into useful information to act on time and grow with order.' },
];
---

<Layout title="Mission | EntityX" description="EntityX's mission: help small and medium-sized businesses centralize and professionalize their management.">
  <Navbar />
  <PurposeStatement
    eyebrow="EntityX purpose"
    title="Our mission"
    statementLabel="Our reason for being"
    statement="Provide small and medium-sized businesses with a practical platform to centralize clients, collections, sales, staff, and daily operations, professionalizing management with clear and reliable information."
    pillars={pillars}
    pillarsEyebrow="How we make it real"
    pillarsTitle="A direction with daily impact."
    homeLabel="Back to home"
    homeHref="/en/"
    nextLabel="Discover our vision"
    nextHref="/en/vision"
  />
  <Footer />
</Layout>
