---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    {params: {lang: 'en'}},
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as any); // cast to any to avoid strict type error during dev if types aren't fully updated yet
---

<Layout 
  title={t('seo.partners.title')}
  description={t('seo.partners.desc')}
  keywords={t('seo.partners.keywords')}
>
    <Navbar />
    
    <main class="pt-5 mt-5">
        <!-- Hero Section -->
        <section class="py-5 text-center text-white bg-dark-teal position-relative overflow-hidden">
            <div class="container py-5 position-relative z-1">
                <span class="badge rounded-pill bg-info text-dark mb-3">{t('partners.badge')}</span>
                <h1 class="fw-bold text-gradient mb-4 responsive-partner-title">{t('partners.hero.title')}</h1>
                <p class="mx-auto text-light responsive-partner-desc" style="max-width: 800px;">{t('partners.hero.desc')}</p>
            </div>
            <!-- Abstract Background Decoration -->
            <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25" style="background: radial-gradient(circle at 50% 50%, #00ffc8 0%, transparent 50%);"></div>
        </section>

        <!-- Features List -->
        <section class="py-5 bg-body">
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6">
                         <img src="/imagenes/photo-1556761175-5973dc0f32e7.avif" class="img-fluid rounded-4 shadow-lg mb-4" alt="EntityX partner program for selling sports management software" loading="lazy" decoding="async">
                    </div>
                    <div class="col-lg-6">
                        <div class="d-flex mb-4">
                            <div class="flex-shrink-0">
                                <div class="bg-sidebar p-3 rounded-circle text-neon border border-secondary">
                                    <i class="bi bi-mortarboard fs-4"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h3 class="h4 ">{t('partners.list1.title')}</h3>
                                <p class="">{t('partners.list1.desc')}</p>
                            </div>
                        </div>
                        <div class="d-flex mb-4">
                            <div class="flex-shrink-0">
                                <div class="bg-sidebar p-3 rounded-circle text-neon border border-secondary">
                                    <i class="bi bi-speedometer2 fs-4"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h3 class="h4 ">{t('partners.list2.title')}</h3>
                                <p class="">{t('partners.list2.desc')}</p>
                            </div>
                        </div>
                        <div class="d-flex mb-4">
                            <div class="flex-shrink-0">
                                <div class="bg-sidebar p-3 rounded-circle  border border-secondary">
                                    <i class="bi bi-people fs-4"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h3 class="h4 ">{t('partners.list3.title')}</h3>
                                <p class="">{t('partners.list3.desc')}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-5 align-items-center mt-4">
                     <div class="col-lg-6 order-lg-2">
                         <img src="/imagenes/photo-1542744173-05336fcc7ad4.avif" class="img-fluid rounded-4 shadow-lg mb-4" alt="Commission and sales tracking dashboard for EntityX partners" loading="lazy" decoding="async">
                    </div>
                    <div class="col-lg-6 order-lg-1">
                        <div class="d-flex mb-4">
                            <div class="flex-shrink-0">
                                <div class="bg-sidebar p-3 rounded-circle text-neon border border-secondary">
                                    <i class="bi bi-wallet2 fs-4"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h3 class="h4 ">{t('partners.list4.title')}</h3>
                                <p class="">{t('partners.list4.desc')}</p>
                            </div>
                        </div>
                         <div class="d-flex mb-4">
                            <div class="flex-shrink-0">
                                <div class="bg-sidebar p-3 rounded-circle  border border-secondary">
                                    <i class="bi bi-briefcase fs-4"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h3 class="h4 ">{t('partners.list5.title')}</h3>
                                <p class="">{t('partners.list5.desc')}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-5 bg-dark-teal text-center">
            <div class="container">
                <h2 class="text-gradient mb-4">{t('partners.cta.title')}</h2>
                <a href="https://wa.me/59170668135?text=Hola,%20estoy%20interesado%20en%20el%20programa%20de%20asociados%20de%20EntityX" target="_blank" class="btn btn-primary rounded-pill shadow-lg responsive-cta-btn">
                    <i class="bi bi-whatsapp me-2"></i> {t('partners.cta.button')}
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style lang="scss">
    @import "../../styles/variables";
    
    .text-gradient {
        background: linear-gradient(120deg, $text-light 0%, $active-color 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .responsive-partner-title {
        font-size: 2.25rem;
        line-height: 1.15;
    }

    .responsive-partner-desc {
        font-size: 1.05rem;
        line-height: 1.5;
    }

    .responsive-cta-btn {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
    }
    main h2 {
        font-size: 2.35rem;
        line-height: 1.18;
    }
    main h3 {
        font-size: 1.05rem;
        line-height: 1.3;
    }
    main p {
        font-size: 0.95rem;
        line-height: 1.45;
    }

    @media (min-width: 768px) {
        .responsive-partner-title {
            font-size: 3.25rem;
        }

        .responsive-partner-desc {
            font-size: 1.25rem; /* Equivalent to lead */
        }

        .responsive-cta-btn {
            padding: 1rem 3rem; 
            font-size: 1.1rem;
        }
    }

    @media (min-width: 1200px) {
        .responsive-partner-title {
            font-size: 3.75rem;
        }

        .responsive-partner-desc {
            font-size: 1.35rem;
        }
    }

    @media (max-width: 1199.98px) {
        main > section.py-5 {
            padding-top: 2.5rem !important;
            padding-bottom: 2.5rem !important;
        }
        main .container.py-5 {
            padding-top: 2.5rem !important;
            padding-bottom: 2.5rem !important;
        }
        .row.g-5 {
            --bs-gutter-x: 1.5rem;
            --bs-gutter-y: 1.5rem;
        }
        .responsive-partner-title {
            font-size: 2.8rem;
        }
        .responsive-partner-desc {
            font-size: 1.1rem;
        }
        main h2 {
            font-size: 2rem;
        }
        main h3 {
            font-size: 0.98rem;
        }
        main p {
            font-size: 0.88rem;
        }
        .d-flex.mb-4 {
            margin-bottom: 1rem !important;
        }
        .bg-sidebar.p-3 {
            padding: 0.85rem !important;
        }
    }

    @media (max-width: 991.98px) {
        .responsive-partner-title {
            font-size: 2.35rem;
        }
        .responsive-partner-desc {
            font-size: 1rem;
        }
        main h2 {
            font-size: 1.75rem;
        }
        main h3 {
            font-size: 0.92rem;
        }
        main p {
            font-size: 0.82rem;
            line-height: 1.4;
        }
        .d-flex.mb-4 {
            margin-bottom: 0.85rem !important;
        }
        .flex-grow-1.ms-3 {
            margin-left: 0.75rem !important;
        }
        .bg-sidebar.p-3 {
            padding: 0.7rem !important;
        }
        .bg-sidebar .fs-4 {
            font-size: 1.15rem !important;
        }
        .responsive-cta-btn {
            padding: 0.72rem 1.6rem;
            font-size: 0.95rem;
        }
    }

    @media (max-width: 575.98px) {
        main > section.py-5 {
            padding-top: 1.75rem !important;
            padding-bottom: 1.75rem !important;
        }
        main .container.py-5 {
            padding-top: 1.75rem !important;
            padding-bottom: 1.75rem !important;
        }
        .responsive-partner-title {
            font-size: 1.8rem;
            line-height: 1.18;
        }
        .responsive-partner-desc {
            font-size: 0.92rem;
        }
        main h2 {
            font-size: 1.45rem;
            margin-bottom: 1rem !important;
        }
        main h3 {
            font-size: 0.86rem;
            margin-bottom: 0.35rem;
        }
        main p {
            font-size: 0.78rem;
            line-height: 1.35;
            margin-bottom: 0;
        }
        .bg-sidebar.p-3 {
            padding: 0.58rem !important;
        }
        .bg-sidebar .fs-4 {
            font-size: 1rem !important;
        }
        .responsive-cta-btn {
            width: 100%;
            padding: 0.65rem 1rem;
            font-size: 0.9rem;
        }
    }
</style>
