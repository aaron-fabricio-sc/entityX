---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PurposeStatement from "../components/PurposeStatement.astro";

const pillars = [
  { icon: "bi-universal-access", title: "Gestión accesible", description: "Una plataforma en la nube que permite ordenar la operación sin exigir infraestructura costosa ni conocimiento técnico avanzado." },
  { icon: "bi-diagram-3-fill", title: "Información conectada", description: "Clientes, cobros, ventas, personal y reportes reunidos para que cada empresa trabaje con una fuente confiable de información." },
  { icon: "bi-rocket-takeoff-fill", title: "Crecimiento sostenible", description: "Un núcleo que puede evolucionar hacia sectores compatibles sin perder foco en el control de la operación diaria." },
];
---

<Layout
  title="Visión | EntityX"
  description="La visión de EntityX: ser el aliado tecnológico de pequeñas y medianas empresas para ordenar su operación y crecer."
>
  <Navbar />
  <PurposeStatement
    eyebrow="Horizonte de EntityX"
    title="Nuestra visión"
    statementLabel="Hacia dónde vamos"
    statement="Convertir a EntityX en el aliado tecnológico de las pequeñas y medianas empresas que buscan profesionalizar su operación, centralizar su información y crecer sin depender de herramientas costosas o procesos fragmentados."
    statementImage="/imagenes/entityx-vision-fondo.png"
    pillars={pillars}
    pillarsEyebrow="Cómo lo hacemos realidad"
    pillarsTitle="Una dirección con impacto diario."
    homeLabel="Volver al inicio"
    homeHref="/"
    nextLabel="Conoce nuestra misión"
    nextHref="/mission"
  />
  <Footer />
</Layout>
