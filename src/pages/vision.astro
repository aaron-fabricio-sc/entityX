---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PurposeStatement from "../components/PurposeStatement.astro";

const pillars = [
  { icon: "bi-universal-access", title: "Fácil de usar", description: "Una herramienta sencilla para organizar el negocio sin equipos especiales ni conocimientos técnicos." },
  { icon: "bi-diagram-3-fill", title: "Todo más claro", description: "Clientes, ventas, productos, equipo y cuentas reunidos para que todos sepan dónde encontrar la información." },
  { icon: "bi-rocket-takeoff-fill", title: "Crecer con orden", description: "Acompañar a cada empresa a medida que suma clientes, productos, sucursales y nuevas formas de trabajar." },
];
---

<Layout
  title="Visión | EntityX"
  description="La visión de EntityX es ayudar a pequeñas y medianas empresas a llevar su negocio en orden y crecer con confianza."
>
  <Navbar />
  <PurposeStatement
    eyebrow="Horizonte de EntityX"
    title="Nuestra visión"
    statementLabel="Hacia dónde vamos"
    statement="Ser una herramienta de confianza para las pequeñas y medianas empresas que quieren ordenar sus clientes, ventas, productos y equipo, y crecer sin depender de papeles o información repartida."
    statementImage="/imagenes/entityx-vision-fondo.png"
    pillars={pillars}
    pillarsEyebrow="Cómo lo hacemos realidad"
    pillarsTitle="Una dirección con impacto diario."
    homeLabel="Volver al inicio"
    homeHref="/"
    nextLabel="Conoce nuestra misión"
    nextHref="/mission"
  />
  <Footer />
</Layout>
