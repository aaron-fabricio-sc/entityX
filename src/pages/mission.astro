---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PurposeStatement from "../components/PurposeStatement.astro";

const pillars = [
  { icon: "bi-diagram-3-fill", title: "Poner todo en un solo lugar", description: "Reunir la información que hoy puede estar repartida entre cuadernos, archivos, recibos y mensajes." },
  { icon: "bi-clipboard2-check", title: "Hacer más sencillo el trabajo diario", description: "Ayudar a dueños y equipos a anotar, consultar y organizar lo que hacen cada día." },
  { icon: "bi-bar-chart-line", title: "Tomar mejores decisiones", description: "Mostrar con claridad los clientes, las ventas y el dinero para saber qué está pasando y qué hacer después." },
];
---

<Layout
  title="Misión | EntityX"
  description="La misión de EntityX es ayudar a pequeñas y medianas empresas a organizar clientes, ventas, productos y trabajo diario."
>
  <Navbar />
  <PurposeStatement
    eyebrow="Propósito de EntityX"
    title="Nuestra misión"
    statementLabel="Nuestra razón de ser"
    statement="Ayudar a pequeñas y medianas empresas a organizar sus clientes, ventas, productos, equipo y trabajo diario, para que sepan qué pasa en su negocio y puedan decidir con confianza."
    statementImage="/imagenes/entityx-mision-fondo.png?v=2"
    pillars={pillars}
    pillarsEyebrow="Cómo lo hacemos realidad"
    pillarsTitle="Una dirección con impacto diario."
    homeLabel="Volver al inicio"
    homeHref="/"
    nextLabel="Conoce nuestra visión"
    nextHref="/vision"
  />
  <Footer />
</Layout>
