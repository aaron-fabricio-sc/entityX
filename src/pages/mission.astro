---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PurposeStatement from "../components/PurposeStatement.astro";

const pillars = [
  { icon: "bi-diagram-3-fill", title: "Centralizar lo esencial", description: "Reunir en un solo lugar la información que suele quedar dispersa entre cuadernos, archivos, recibos y mensajes." },
  { icon: "bi-clipboard2-check", title: "Facilitar el control diario", description: "Dar a propietarios y equipos una forma simple de registrar, consultar y dar seguimiento a la operación de cada día." },
  { icon: "bi-bar-chart-line", title: "Decidir con confianza", description: "Convertir los datos de clientes, cobros, ventas y actividad en información útil para actuar a tiempo y crecer con orden." },
];
---

<Layout
  title="Misión | EntityX"
  description="La misión de EntityX: ayudar a pequeñas y medianas empresas a centralizar y profesionalizar su gestión."
>
  <Navbar />
  <PurposeStatement
    eyebrow="Propósito de EntityX"
    title="Nuestra misión"
    statementLabel="Nuestra razón de ser"
    statement="Brindar a las pequeñas y medianas empresas una plataforma práctica para centralizar clientes, cobros, ventas, personal y operación diaria, profesionalizando su gestión con información clara y confiable."
    statementImage="/imagenes/entityx-mision-fondo.png?v=2"
    pillars={pillars}
    pillarsEyebrow="Cómo lo hacemos realidad"
    pillarsTitle="Una dirección con impacto diario."
    homeLabel="Volver al inicio"
    homeHref="/"
    nextLabel="Conoce nuestra visión"
    nextHref="/vision"
  />
  <Footer />
</Layout>
