---
import '../styles/global.scss';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title: string;
    description?: string;
    image?: string;
    keywords?: string;
}

const { title, description, image = import.meta.env.BASE_URL + 'imagenes/banerredes-v2.jpeg', keywords } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(image, Astro.url);
const siteUrl = Astro.site ?? new URL('https://entityx.tech');
const pathWithoutLang = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const spanishPath = pathWithoutLang;
const englishPath = pathWithoutLang === '/' ? '/en/' : `/en${pathWithoutLang}`;
const alternateUrls = {
    es: new URL(spanishPath, siteUrl),
    en: new URL(englishPath, siteUrl),
    default: new URL(spanishPath, siteUrl),
};
const defaultDescription = lang === 'en'
    ? 'An app for organizing the daily work of small and medium-sized businesses.'
    : 'Una aplicación para ordenar el trabajo diario de pequeñas y medianas empresas.';
const imageAlt = lang === 'en'
    ? 'EntityX, an app for organizing businesses and companies'
    : 'EntityX, una aplicación para organizar negocios y empresas';
const featureList = lang === 'en'
    ? [
        'Customer management',
        'Payment and membership control',
        'Access verification',
        'Sales records',
        'Personal space for customers',
        'Staff control and attendance',
        'Business reports',
        'Activity schedule',
      ]
    : [
        'Gestión de clientes',
        'Control de cobros y membresías',
        'Verificación de accesos',
        'Registro de ventas',
        'Espacio personal para clientes',
        'Control del personal y asistencia',
        'Reportes del negocio',
        'Cartelera de actividades',
      ];
const structuredData = [
    {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'EntityX',
        url: siteUrl.toString(),
        logo: new URL(import.meta.env.BASE_URL + 'imagenes/logo-entityx.png', siteUrl).toString(),
    },
    {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'EntityX',
        url: siteUrl.toString(),
        inLanguage: lang === 'es' ? 'es-BO' : 'en-US',
    },
    {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'EntityX',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        url: siteUrl.toString(),
        image: socialImageUrl.toString(),
        description: description || defaultDescription,
        offers: {
            '@type': 'Offer',
            url: new URL('/pricing', siteUrl).toString(),
            availability: 'https://schema.org/InStock',
        },
        featureList,
        publisher: {
            '@type': 'Organization',
            name: 'EntityX',
            url: siteUrl.toString(),
        },
    },
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description || "EntityX"} />
        {keywords && <meta name="keywords" content={keywords} />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="index, follow" />
        <meta name="author" content="EntityX" />
        <meta name="theme-color" content="#021014" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="es" href={alternateUrls.es} />
        <link rel="alternate" hreflang="en" href={alternateUrls.en} />
        <link rel="alternate" hreflang="x-default" href={alternateUrls.default} />
		<link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.ico'} />
        <link rel="shortcut icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="EntityX" />
        <meta property="og:locale" content={lang === 'es' ? 'es_BO' : 'en_US'} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:secure_url" content={socialImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalUrl} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageUrl} />
        <!-- Bootstrap CSS CDN -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <!-- Bootstrap Icons CDN -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	</head>
	<body class="bg-body text-body">
		<slot />
		
        <!-- Bootstrap JS CDN -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	</body>
</html>
